+def _phase_lock_for(slug: str) -> asyncio.Lock:
+    lock = _PROJECT_PHASE_LOCKS.get(slug)
+    if lock is None:
+        lock = asyncio.Lock()
+        _PROJECT_PHASE_LOCKS[slug] = lock
+    return lock
