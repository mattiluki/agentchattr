+def _commit_phase_repos(slug: str, wf: dict, task_id, phase: str | None) -> list[dict]:
+    import datetime as _dt
+
+    repos = wf.get("repos_to_commit") or []
+    do_push = wf.get("auto_push", True)
+    commit_msg = (
+        f"feat({slug}): phase {phase} done · task #{task_id}\n\n"
+        f"Auto-committed by AgentOS coordinator after user approval at "
+        f"{_dt.datetime.now().isoformat(timespec='seconds')}.\n\n"
+        f"🤖 Generated with [Claude Code](https://claude.com/claude-code)"
+    )
+
+    results = []
+    for repo in repos:
+        repo_path = Path(repo)
+        if not (repo_path / ".git").exists():
+            results.append({"repo": repo, "skipped": "not a git repo"})
+            continue
+        try:
+            subprocess.run(["/usr/bin/git", "-C", repo, "add", "-A"], check=True, capture_output=True, timeout=10)
+            status = subprocess.run(["/usr/bin/git", "-C", repo, "status", "--porcelain"],
+                                    capture_output=True, text=True, timeout=5).stdout
+            if not status.strip():
+                results.append({"repo": repo, "skipped": "no changes"})
+                continue
+            subprocess.run(["/usr/bin/git", "-C", repo, "commit", "-m", commit_msg],
+                           check=True, capture_output=True, timeout=15)
+            commit_sha = subprocess.run(["/usr/bin/git", "-C", repo, "rev-parse", "HEAD"],
+                                        capture_output=True, text=True, timeout=5).stdout.strip()[:8]
+            push_result = "skipped (no remote or auto_push=false)"
+            if do_push:
+                remote = subprocess.run(["/usr/bin/git", "-C", repo, "remote"],
+                                        capture_output=True, text=True, timeout=3).stdout.strip()
+                if remote:
+                    try:
+                        subprocess.run(["/usr/bin/git", "-C", repo, "push"],
+                                       check=True, capture_output=True, timeout=60)
+                        push_result = "pushed"
+                    except subprocess.CalledProcessError as e:
+                        push_result = f"push failed: {e.stderr.decode()[:100] if e.stderr else 'error'}"
+            results.append({"repo": repo, "commit": commit_sha, "sha": commit_sha, "push": push_result})
+        except subprocess.CalledProcessError as e:
+            results.append({"repo": repo, "error": e.stderr.decode()[:200] if e.stderr else "git failed"})
+        except Exception as e:
+            results.append({"repo": repo, "error": str(e)[:200]})
+    return results
+
+
+def _finish_approved_phase(slug: str, pr: dict, fm: dict, wf: dict, *, write_before_commit: bool = False) -> dict:
+    task_id = wf.get("active_task_id")
+    phase = wf.get("active_phase")
+    current_phase = _phase_by_name(wf, phase)
+    body = pr.get("body") or ""
+
+    if write_before_commit:
+        if current_phase.get("pause_after") is True:
+            wf["phase_state"] = "paused_for_review"
+            msg = f"phase {phase!r} paused for HITL review"
+        else:
+            msg = _advance_workflow_phase(pr, fm, wf, task_id)
+        if wf.get("phase_state") != "paused_for_review":
+            wf.pop("pending_review_path", None)
+        fm["workflow"] = wf
+        _write_vault_page(PROJECTS_DIR, slug, fm, body)
+
+    results = _commit_phase_repos(slug, wf, task_id, phase)
+    commit_refs = _normalize_commit_results(results)
+    approved_event = _record_phase_event(
+        "phase-approved",
+        slug,
+        wf,
+        task_id,
+        phase,
+        f"approved phase {phase!r} for task #{task_id}",
+        {"commits": commit_refs},
+    )
+
+    if not write_before_commit:
+        if current_phase.get("pause_after") is True:
+            wf["phase_state"] = "paused_for_review"
+            msg = f"phase {phase!r} paused for HITL review"
+            event = _record_phase_event("phase-paused", slug, wf, task_id, phase, msg)
+        else:
+            msg = _advance_workflow_phase(pr, fm, wf, task_id)
+            event = approved_event
+        if wf.get("phase_state") != "paused_for_review":
+            wf.pop("pending_review_path", None)
+        fm["workflow"] = wf
+        _write_vault_page(PROJECTS_DIR, slug, fm, body)
+    else:
+        event = approved_event
+        if current_phase.get("pause_after") is True:
+            event = _record_phase_event("phase-paused", slug, wf, task_id, phase, msg)
+
+    return {
+        "ok": True,
+        "approved_phase": phase,
+        "task_id": task_id,
+        "commits": results,
+        "paused": wf.get("phase_state") == "paused_for_review",
+        "event": event,
+        "next": msg,
+    }
+
+
+async def _approve_current_phase(slug: str, *, write_before_commit: bool = False,
+                                 pr: dict | None = None, fm: dict | None = None,
+                                 wf: dict | None = None) -> dict:
+    if pr is None:
+        pr = _read_vault_page(PROJECTS_DIR, slug, PROJECT_EXTRA_FIELDS)
+    if not pr:
+        return {"error": "project not found"}
+    if fm is None:
+        fm = dict(pr["_frontmatter"])
+    if wf is None:
+        wf = fm.get("workflow") or {}
+    if wf.get("phase_state") != "pending_user_approval":
+        return {"error": f"no phase pending approval (state={wf.get('phase_state')!r})"}
+
+    result = _finish_approved_phase(slug, pr, fm, wf, write_before_commit=write_before_commit)
+    if result.get("paused"):
+        channels = pr.get("channels") or []
+        if channels:
+            await _post_system_notice(
+                channels[0],
+                f"Phase {result.get('approved_phase')} paused for HITL review — "
+                f"confirm to continue task #{result.get('task_id')}.",
+            )
+    return result
 
 
