+def _vault_relative_exists(rel_path: str) -> bool:
+    if not rel_path:
+        return True
+    try:
+        target = (VAULT / rel_path).resolve()
+        vault_root = VAULT.resolve()
+        if target != vault_root and vault_root not in target.parents:
+            return False
+        return target.exists()
+    except Exception:
+        return False
+
+
+def _reset_blocked_pause_counters(wf: dict):
+    wf["consecutive_blocked_count"] = 0
+    wf["last_blocked_reasons"] = []
+    wf.pop("pause_reason", None)
+
