+function canRevertProjectPhaseEvent(ev, events) {
+  const commits = ev.commits || [];
+  if (!["phase-approved", "phase-committed"].includes(ev.kind)) return false;
+  if (commits.length === 0) return false;
+  return !(events || []).some((candidate) => (
+    candidate.kind === "phase-reverted" && candidate.original_ts === ev.ts
+  ));
+}
+
+function ProjectPhaseEvents({ slug }) {
+  const [events, setEvents] = React.useState([]);
+  const [msg, setMsg] = React.useState("");
+
+  const load = React.useCallback(() => {
+    fetch(`/api/projects/${encodeURIComponent(slug)}/phase-events?limit=12`)
+      .then(r => r.json())
+      .then(d => setEvents(Array.isArray(d) ? d : []))
+      .catch(() => {});
+  }, [slug]);
+
+  React.useEffect(() => {
+    load();
+    const t = setInterval(load, 10000);
+    return () => clearInterval(t);
+  }, [load]);
+
+  if (!events.length) return null;
+
+  const revert = async (ev) => {
+    const commits = ev.commits || [];
+    if (!ev.ts || commits.length === 0) return;
+    if (!confirm(`Revert phase '${ev.phase || "?"}' for task #${ev.task_id || "?"}? Reverts commits in ${commits.length} repos.`)) return;
+    setMsg("reverting...");
+    try {
+      const r = await fetch(`/api/projects/${encodeURIComponent(slug)}/phase-events/${encodeURIComponent(ev.ts)}/revert`, { method: "POST" });
+      const d = await r.json();
+      if (d.error) setMsg(`error: ${d.error}`);
+      else {
+        const summary = (d.reverts || []).map(x => `${x.repo.split("/").pop()}:${x.revert_sha}`).join(", ");
+        setMsg(`reverted: ${summary || "done"}`);
+        setTimeout(load, 800);
+      }
+    } catch (e) {
+      setMsg(`error: ${String(e).slice(0,120)}`);
+    }
+  };
+
+  return (
+    <div style={{
+      marginTop: 12, padding: "10px 12px",
+      background: "var(--bg-sunken)", borderRadius: 8,
+      border: "1px solid var(--line)",
+    }}>
+      <div style={{display:"flex",alignItems:"center",gap:8,marginBottom:8}}>
+        <div className="mono muted" style={{fontSize:10,letterSpacing:0.06,textTransform:"uppercase",flex:1}}>
+          phase events
+        </div>
+        <button className="btn btn-ghost mono" style={{padding:"3px 8px",fontSize:10}} onClick={load}>refresh</button>
+      </div>
+      {events.map((ev, i) => {
+        const revertable = canRevertProjectPhaseEvent(ev, events);
+        const reverted = events.some(candidate => candidate.kind === "phase-reverted" && candidate.original_ts === ev.ts);
+        return (
+          <div key={`${ev.kind}-${ev.ts}-${i}`} className="phase-event-row" style={{
+            padding:"7px 0",borderTop:i ? "1px solid var(--line)" : 0,
+            opacity: reverted ? 0.6 : 1,
+            textDecoration: reverted ? "line-through" : "none",
+          }}>
+            <div style={{display:"flex",alignItems:"center",gap:6}}>
+              <span className="mono" style={{fontSize:10,color:"var(--accent)",flex:1}}>
+                {ev.kind || "event"} · {ev.phase || "phase?"}
+              </span>
+              {revertable && (
+                <button className="phase-revert-btn mono" title="Revert phase commits" onClick={() => revert(ev)}>
+                  ⌫
+                </button>
+              )}
+            </div>
+            <div style={{fontSize:12,color:"var(--ink-2)",marginTop:2}}>{ev.summary || ev.next || "No summary"}</div>
+            <div className="mono muted" style={{fontSize:10,marginTop:2}}>
+              task {ev.task_id ? `#${ev.task_id}` : "?"} · {ev.ts || ""} {ev.agent ? `· @${ev.agent}` : ""}
+            </div>
+          </div>
+        );
+      })}
+      {msg && <div className="define-msg mono" style={{marginTop:8}}>{msg}</div>}
+    </div>
+  );
+}
