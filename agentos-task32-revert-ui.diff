+@app.post("/api/projects/{slug}/phase-events/{event_ts}/revert")
+async def project_phase_event_revert(slug: str, event_ts: str):
+    import subprocess as _sp
+
+    pr = _read_vault_page(PROJECTS_DIR, slug, PROJECT_EXTRA_FIELDS)
+    if not pr:
+        return JSONResponse(status_code=404, content={"error": "project not found"})
+
+    event, events = _find_phase_event(slug, event_ts)
+    if not event:
+        return JSONResponse(status_code=400, content={"error": "phase event not found"})
+    if event.get("kind") not in ("phase-approved", "phase-committed"):
+        return JSONResponse(status_code=400, content={"error": "event is not revertable"})
+
+    commits = event.get("commits") or []
+    if not commits:
+        return JSONResponse(status_code=400, content={"error": "event has no commits to revert"})
+
+    if any(ev.get("kind") == "phase-reverted" and ev.get("original_ts") == event_ts for ev in events):
+        return JSONResponse(status_code=409, content={"error": "phase event already reverted"})
+
+    wf = (pr.get("_frontmatter") or {}).get("workflow") or {}
+    if wf.get("auto_commit") is False:
+        return JSONResponse(status_code=400, content={"error": "workflow auto_commit is disabled"})
+    do_push = wf.get("auto_push", True)
+    reverts = []
+    for item in commits:
+        repo = item.get("repo")
+        original_sha = item.get("sha") or item.get("commit")
+        if not repo or not original_sha:
+            continue
+        repo_path = Path(repo)
+        if not (repo_path / ".git").exists():
+            return JSONResponse(status_code=400, content={"error": f"not a git repo: {repo}"})
+        try:
+            _sp.run(
+                ["/usr/bin/git", "-C", repo, "revert", "--no-edit", original_sha],
+                check=True,
+                capture_output=True,
+                timeout=30,
+            )
+            revert_sha = _sp.run(
+                ["/usr/bin/git", "-C", repo, "rev-parse", "HEAD"],
+                check=True,
+                capture_output=True,
+                text=True,
+                timeout=5,
+            ).stdout.strip()[:8]
+            push_result = "skipped (no remote or auto_push=false)"
+            current_revert = {
+                "repo": repo,
+                "original_sha": original_sha,
+                "revert_sha": revert_sha,
+                "push": push_result,
+            }
+            if do_push:
+                remote = _sp.run(
+                    ["/usr/bin/git", "-C", repo, "remote"],
+                    capture_output=True,
+                    text=True,
+                    timeout=3,
+                ).stdout.strip()
+                if remote:
+                    try:
+                        _sp.run(["/usr/bin/git", "-C", repo, "push"], check=True, capture_output=True, timeout=60)
+                        current_revert["push"] = "pushed"
+                    except _sp.CalledProcessError as e:
+                        stderr = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+                        reverts.append(current_revert)
+                        return JSONResponse(
+                            status_code=409,
+                            content={"error": f"git push failed for {repo}: {stderr[:200] or 'git failed'}", "reverts": reverts},
+                        )
+            reverts.append(current_revert)
+        except _sp.CalledProcessError as e:
+            stderr = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+            return JSONResponse(
+                status_code=409,
+                content={"error": f"git revert failed for {repo}: {stderr[:200] or 'git failed'}", "reverts": reverts},
+            )
+        except Exception as e:
+            return JSONResponse(
+                status_code=409,
+                content={"error": f"revert failed for {repo}: {str(e)[:200]}", "reverts": reverts},
+            )
+
+    new_event = _record_phase_event(
+        "phase-reverted",
+        slug,
+        wf,
+        event.get("task_id"),
+        event.get("phase"),
+        f"reverted commits from ts={event_ts}",
+        {
+            "original_ts": event_ts,
+            "revert_commits": [{"repo": r["repo"], "sha": r["revert_sha"]} for r in reverts],
+        },
+    )
+    return {"ok": True, "reverts": reverts, "event": new_event}
+
