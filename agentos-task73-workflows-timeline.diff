diff --git a/ui-static/screens/workflows.jsx b/ui-static/screens/workflows.jsx
index 9561dca..c99834d 100644
--- a/ui-static/screens/workflows.jsx
+++ b/ui-static/screens/workflows.jsx
@@ -137,6 +137,160 @@ function WorkflowsScreen({ onSelectAgent, onNavigate }) {
           />
         </div>
       )}
+
+      {focused && (
+        <WorkflowTimelineView projectSlug={focused.project_slug} />
+      )}
+    </div>
+  );
+}
+
+function _formatTimelineDuration(sec) {
+  if (sec == null) return "—";
+  if (sec < 60) return `${sec}s`;
+  if (sec < 3600) return `${Math.floor(sec/60)}m ${sec%60}s`;
+  if (sec < 86400) return `${Math.floor(sec/3600)}h ${Math.floor((sec%3600)/60)}m`;
+  return `${Math.floor(sec/86400)}d ${Math.floor((sec%86400)/3600)}h`;
+}
+
+const TIMELINE_PHASE_STATUS_COLORS = {
+  "in_progress": "#3fb950",
+  "done":        "#10b981",
+  "blocked":     "#f59e0b",
+  "pending":     "#6b7280",
+};
+
+function WorkflowTimelineView({ projectSlug }) {
+  const [rows, setRows]       = React.useState([]);
+  const [loading, setLoading] = React.useState(false);
+  const [error, setError]     = React.useState("");
+
+  const load = React.useCallback(() => {
+    if (!projectSlug) return;
+    setLoading(true);
+    fetch(`/api/projects/${encodeURIComponent(projectSlug)}/timeline?limit_tasks=30`)
+      .then(r => r.json())
+      .then(d => {
+        if (Array.isArray(d)) { setRows(d); setError(""); }
+        else { setRows([]); setError(d?.error || "unknown error"); }
+        setLoading(false);
+      })
+      .catch(e => { setError(String(e).slice(0,120)); setLoading(false); });
+  }, [projectSlug]);
+
+  React.useEffect(() => {
+    load();
+    const t = setInterval(load, 30000);
+    return () => clearInterval(t);
+  }, [load]);
+
+  return (
+    <div style={{
+      marginTop: 20, padding: "14px 16px",
+      border: "1px solid var(--line)", borderRadius: 8,
+      background: "var(--bg-sunken)",
+    }}>
+      <div style={{display:"flex",alignItems:"baseline",gap:10,marginBottom:10}}>
+        <div style={{fontWeight:700,fontSize:13}}>Timeline · {projectSlug}</div>
+        <div className="mono muted" style={{fontSize:11}}>
+          {rows.length} task{rows.length===1?"":"s"} · Plan → Build → Review · server-side groupBy from phase-events
+        </div>
+        <div style={{flex:1}} />
+        <button onClick={load} disabled={loading} className="mono" style={{
+          padding:"4px 10px",border:"1px solid var(--line-strong)",borderRadius:5,
+          background:"transparent",color:"var(--ink-2)",cursor:"pointer",fontSize:11,
+        }}>{loading ? "loading…" : "refresh"}</button>
+      </div>
+
+      {error && (
+        <div className="mono" style={{fontSize:11,color:"#dc2626",marginBottom:8}}>error: {error}</div>
+      )}
+
+      {rows.length === 0 && !loading && !error && (
+        <div className="muted" style={{padding:"30px 0",textAlign:"center",fontSize:12}}>
+          No task cycles recorded yet. Phase events will appear here as tasks progress through Plan → Build → Review.
+        </div>
+      )}
+
+      {rows.map(row => (
+        <TimelineTaskRow key={row.task_id} row={row} />
+      ))}
+    </div>
+  );
+}
+
+function TimelineTaskRow({ row }) {
+  return (
+    <div style={{
+      display:"grid",
+      gridTemplateColumns:"minmax(220px, 1.2fr) repeat(auto-fit, minmax(180px, 1fr))",
+      gap:10, padding:"10px 0",
+      borderTop:"1px solid var(--line)",
+      alignItems:"stretch",
+    }}>
+      <div style={{display:"flex",flexDirection:"column",gap:4,paddingRight:8}}>
+        <div className="mono" style={{fontSize:11,color:"var(--muted)"}}>
+          #{row.task_id}{row.is_active ? " · ACTIVE" : ""}
+        </div>
+        <div style={{fontSize:12.5,fontWeight:row.is_active ? 700 : 500,color:"var(--ink-1)",lineHeight:1.3}}>
+          {row.task_title || "(untitled)"}
+        </div>
+        <div className="mono" style={{
+          fontSize:10,marginTop:2,padding:"1px 7px",borderRadius:3,alignSelf:"flex-start",
+          background: row.task_status === "done" ? "#10b98122" : row.task_status === "blocked" ? "#f59e0b22" : "#6b728022",
+          color:      row.task_status === "done" ? "#10b981"   : row.task_status === "blocked" ? "#f59e0b"   : "#6b7280",
+          textTransform:"uppercase",letterSpacing:0.04,fontWeight:700,
+        }}>{row.task_status || "?"}</div>
+      </div>
+
+      {(row.phases || []).map((p, i) => (
+        <TimelinePhaseCell key={`${row.task_id}-${p.name}-${i}`} phase={p} isActive={row.is_active && p.status === "in_progress"} />
+      ))}
+    </div>
+  );
+}
+
+function TimelinePhaseCell({ phase, isActive }) {
+  const color = TIMELINE_PHASE_STATUS_COLORS[phase.status] || "var(--muted)";
+  return (
+    <div style={{
+      padding:"8px 10px",borderRadius:6,
+      background: isActive ? `${color}11` : "var(--bg-1)",
+      border: isActive ? `1px solid ${color}` : "1px solid var(--line)",
+      display:"flex",flexDirection:"column",gap:4,minHeight:80,
+    }}>
+      <div style={{display:"flex",alignItems:"center",gap:6}}>
+        <span style={{
+          width:7,height:7,borderRadius:"50%",background:color,
+          boxShadow: isActive ? `0 0 0 3px ${color}33` : "none",
+        }} />
+        <span style={{fontWeight:700,fontSize:12}}>{phase.name}</span>
+        <span className="mono" style={{fontSize:10,color:"var(--muted)",marginLeft:"auto"}}>@{phase.agent || "?"}</span>
+      </div>
+      <div style={{display:"flex",alignItems:"baseline",gap:8}}>
+        <span className="mono" style={{fontSize:10,color,fontWeight:700,textTransform:"uppercase",letterSpacing:0.04}}>
+          {phase.status}
+        </span>
+        <span className="mono" style={{fontSize:10,color:"var(--muted)"}}>
+          {_formatTimelineDuration(phase.duration_sec)}
+        </span>
+      </div>
+      {phase.commits && phase.commits.length > 0 && (
+        <div style={{display:"flex",flexWrap:"wrap",gap:3,marginTop:2}}>
+          {phase.commits.map((c, ci) => (
+            <span key={ci} className="mono" title={`${c.repo} · ${c.status || "?"}`} style={{
+              fontSize:9.5,padding:"1px 5px",borderRadius:3,
+              background:"var(--bg-sunken)",color:"var(--ink-2)",
+              border:"1px solid var(--line)",
+            }}>{(c.repo || "?").slice(0,12)} {(c.sha || "").slice(0,7)}</span>
+          ))}
+        </div>
+      )}
+      {phase.last_event_kind && (
+        <div className="mono" style={{fontSize:9.5,color:"var(--muted)",marginTop:"auto"}}>
+          last: {phase.last_event_kind} ({phase.event_count} ev)
+        </div>
+      )}
     </div>
   );
 }
