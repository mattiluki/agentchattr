+@app.get("/api/projects/{slug}/timeline")
+async def project_timeline(slug: str, limit_tasks: int = 30):
+    """Group phase-events into per-task Plan→Build→Review cycles with durations,
+    agent assignments, and commits. Returns newest-task-first.
+
+    Shape:
+      [{task_id, task_title, task_status, is_active, phases: [{name, agent,
+        started_at, finished_at, duration_sec, status, commits: [{repo, sha,
+        status, repo_path?}], last_event_kind, event_count}]}]
+    """
+    import time as _t
+    from collections import defaultdict
+
+    pr = _read_vault_page(PROJECTS_DIR, slug, PROJECT_EXTRA_FIELDS)
+    if not pr:
+        return JSONResponse(status_code=404, content={"error": "project not found"})
+
+    wf = (pr.get("_frontmatter") or {}).get("workflow") or pr.get("workflow") or {}
+    canonical_phases = [p for p in (wf.get("phases") or []) if p.get("name")]
+    canonical_names = [p["name"] for p in canonical_phases]
+    if not canonical_names:
+        canonical_names = ["Plan", "Build", "Review"]
+        canonical_phases = [{"name": n, "agent": wf.get("coordinator_agent")} for n in canonical_names]
+    default_agent = {p["name"]: p.get("agent") for p in canonical_phases}
+    active_task_id = wf.get("active_task_id")
+    active_phase_name = wf.get("active_phase")
+
+    tasks_by_id = {t.get("id"): t for t in (pr.get("tasks") or []) if t.get("id") is not None}
+
+    events = _read_phase_events(2000, slug)
+    by_task: dict[int, list[dict]] = defaultdict(list)
+    for ev in events:
+        tid = ev.get("task_id")
+        if tid is None:
+            continue
+        by_task[tid].append(ev)
+
+    out: list[dict] = []
+    now_iso = _t.strftime("%Y-%m-%dT%H:%M:%S", _t.localtime(_t.time()))
+    for task_id, task_events in by_task.items():
+        task_events.sort(key=lambda e: str(e.get("ts") or ""))
+
+        phases_payload = []
+        for idx, phase_name in enumerate(canonical_names):
+            phase_events = [e for e in task_events if e.get("phase") == phase_name]
+            if not phase_events:
+                is_active_no_events = (task_id == active_task_id and phase_name == active_phase_name)
+                phases_payload.append({
+                    "name": phase_name,
+                    "agent": default_agent.get(phase_name),
+                    "started_at": None,
+                    "finished_at": None,
+                    "duration_sec": None,
+                    "status": "in_progress" if is_active_no_events else "pending",
+                    "commits": [],
+                    "last_event_kind": None,
+                    "event_count": 0,
+                })
+                continue
+
+            started_at = phase_events[0].get("ts")
+            next_phase_name = canonical_names[idx + 1] if idx + 1 < len(canonical_names) else None
+            if next_phase_name:
+                next_events = [e for e in task_events if e.get("phase") == next_phase_name]
+                finished_at = next_events[0].get("ts") if next_events else phase_events[-1].get("ts")
+            else:
+                finished_at = phase_events[-1].get("ts")
+
+            is_active_phase = (task_id == active_task_id and phase_name == active_phase_name)
+            task_done = (task_meta_lookup := tasks_by_id.get(task_id) or {}).get("status") in ("done", "cancelled")
+            task_blocked = task_meta_lookup.get("status") == "blocked"
+            committed = any(e.get("kind") in ("phase-committed", "phase-approved") for e in phase_events)
+            if is_active_phase:
+                phase_status = "in_progress"
+                finished_at_for_duration = now_iso
+            elif task_done:
+                phase_status = "done"
+                finished_at_for_duration = finished_at
+            elif task_blocked:
+                phase_status = "blocked" if committed else "pending"
+                finished_at_for_duration = finished_at
+            elif committed:
+                phase_status = "done"
+                finished_at_for_duration = finished_at
+            else:
+                phase_status = "pending"
+                finished_at_for_duration = finished_at
+
+            start_ep = _audit_entry_ts_epoch({"ts": started_at})
+            end_ep = _audit_entry_ts_epoch({"ts": finished_at_for_duration})
+            duration_sec = int(end_ep - start_ep) if (start_ep and end_ep and end_ep >= start_ep) else None
+
+            commits_seen: set[tuple] = set()
+            commits: list[dict] = []
+            for e in phase_events:
+                for c in (e.get("commits") or []):
+                    key = (c.get("repo"), c.get("sha"))
+                    if key in commits_seen:
+                        continue
+                    commits_seen.add(key)
+                    commits.append({
+                        "repo": c.get("repo"),
+                        "sha": c.get("sha"),
+                        "status": c.get("status"),
+                    })
+
+            phase_agent = None
+            for e in phase_events:
+                if e.get("agent") and e.get("agent") != "user":
+                    phase_agent = e["agent"]
+                    break
+            if not phase_agent:
+                phase_agent = default_agent.get(phase_name)
+
+            phases_payload.append({
+                "name": phase_name,
+                "agent": phase_agent,
+                "started_at": started_at,
+                "finished_at": finished_at,
+                "duration_sec": duration_sec,
+                "status": phase_status,
+                "commits": commits,
+                "last_event_kind": phase_events[-1].get("kind"),
+                "event_count": len(phase_events),
+            })
+
+        last_ts = task_events[-1].get("ts") or ""
+        task_meta = tasks_by_id.get(task_id) or {}
+        out.append({
+            "task_id": task_id,
+            "task_title": task_meta.get("title"),
+            "task_status": task_meta.get("status"),
+            "is_active": task_id == active_task_id,
+            "last_event_ts": last_ts,
+            "phases": phases_payload,
+        })
+
+    out.sort(key=lambda r: r["last_event_ts"], reverse=True)
+    return out[:limit_tasks]
+
+
