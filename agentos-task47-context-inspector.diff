+@app.get("/api/agents/{agent}/context")
+async def agent_context_summary(agent: str, session: str | None = None):
+    agent = agent.strip().lower()
+    sessions = [_inspector_session_record(agent, p) for p in _inspector_files(agent)] if agent in INSPECTOR_ROOTS else []
+    session_id = session or (sessions[0]["id"] if sessions else "")
+    events = _read_context_events(agent, session_id) if session_id else {"events": []}
+    return {
+        "agent": agent,
+        "sessions": sessions,
+        "active_session_id": session_id,
+        "tokens_in": events.get("total_tokens", 0),
+        "tokens_out": 0,
+        "total_tokens": events.get("total_tokens", 0),
+        "context_limit": events.get("context_limit", 0),
+        "context_pct": events.get("context_pct", 0),
+        "model": events.get("model", _read_env_model(agent)),
+        "events": events.get("events", [])[-50:],
+        "error": events.get("error"),
+    }
+
+
 @app.websocket("/ws/inspector")
 async def ws_inspector(client_ws: WebSocket):
     await client_ws.accept()
