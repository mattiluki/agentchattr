+def _read_md_frontmatter(path: pathlib.Path) -> dict:
+    """Small frontmatter reader for artifact detection; avoids depending on yaml."""
+    try:
+        text = path.read_text(encoding="utf-8")
+    except (OSError, UnicodeDecodeError):
+        return {}
+    if not text.startswith("---\n"):
+        return {}
+    end = text.find("\n---\n", 4)
+    if end == -1:
+        return {}
+    fm: dict = {}
+    for raw in text[4:end].splitlines():
+        if ":" not in raw:
+            continue
+        key, value = raw.split(":", 1)
+        fm[key.strip()] = value.strip().strip('"').strip("'")
+    return fm
+
+
+def _phase_artifact_exists(phase: dict, task: dict, task_slug: str) -> bool:
+    """Detect phase artifacts when output_hint is the generic HITL placeholder.
+
+    Build/Review phases write conventional vault artifacts, but their
+    output_hint is often only "<via propose_change to HITL>". Detect by
+    task_id frontmatter first, then by slug+agent filename as a fallback.
+    """
+    hint = str(phase.get("output_hint") or "")
+    if "via propose_change" not in hint.lower():
+        return _output_exists(hint, task_slug)
+
+    pname = str(phase.get("name") or "").lower()
+    if pname == "build":
+        subdir = "builds"
+        agent = _primary_agent(phase)
+    elif pname == "review":
+        subdir = "reviews"
+        agent = _primary_agent(phase) or "gemini"
+    else:
+        return False
+
+    root = pathlib.Path.home() / "Documents" / "obsidian" / "LosAgentOS" / "04-Wiki" / subdir
+    if not root.exists():
+        return False
+    task_id = str(task.get("id") or "")
+    agent_base = str(agent).split("-", 1)[0]
+    for path in root.glob("*.md"):
+        fm = _read_md_frontmatter(path)
+        if task_id and str(fm.get("task_id") or "") == task_id:
+            artifact_agent = str(fm.get("builder") or fm.get("reviewer") or "")
+            if not artifact_agent or artifact_agent.split("-", 1)[0] == agent_base:
+                return True
+
+    fallback = root / f"{task_slug}__{agent_base}.md"
+    return fallback.exists()
+
+
+def _sender_base(sender: str) -> str:
+    return str(sender or "").split("-", 1)[0].lower()
+
+
+def _coordinator_manual_phase_complete(channel: str, coordinator: str, task_id, phase_name: str) -> bool:
+    """Coordinator escape hatch for placeholder phases whose artifacts are odd.
+
+    Accepts a recent message such as "As Coordinator: #80 Build phase is
+    COMPLETE" from claude/claude-1/etc. This is intentionally narrow so ordinary
+    discussion does not advance a phase by accident.
+    """
+    import re as _re
+
+    q = urllib.parse.quote(channel)
+    msgs = _http("GET", f"/api/chat/messages?channel={q}&limit=100") or []
+    cutoff = time.time() - 3600
+    coord_base = _sender_base(coordinator or "claude")
+    pattern = _re.compile(
+        rf"^(?:As Coordinator:\s*)?#?{_re.escape(str(task_id))}\s+"
+        rf"{_re.escape(str(phase_name))}\s+phase\s+is\s+(?:COMPLETE|done)\.?\s*$",
+        _re.IGNORECASE,
+    )
+    for m in msgs:
+        if _sender_base(str(m.get("sender", ""))) != coord_base:
+            continue
+        try:
+            if float(m.get("timestamp") or 0) < cutoff:
+                continue
+        except (TypeError, ValueError):
+            continue
+        text = str(m.get("text") or "")
+        if pattern.match(text.strip()):
+            return True
+    return False
+
+
+def _phase_complete(phase: dict, task: dict, task_slug: str, channel: str, coordinator: str) -> bool:
+    if _phase_artifact_exists(phase, task, task_slug):
+        return True
+    hint = str(phase.get("output_hint") or "")
+    if "via propose_change" not in hint.lower():
+        return False
+    return _coordinator_manual_phase_complete(channel, coordinator, task.get("id"), phase.get("name", ""))
+
