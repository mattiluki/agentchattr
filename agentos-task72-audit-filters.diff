+function _readAuditHash() {
+  if (typeof location === "undefined" || !location.hash) return {};
+  try {
+    const raw = location.hash.replace(/^#\/?audit\??/, "").replace(/^#/, "");
+    const sp = new URLSearchParams(raw);
+    return {
+      since:  sp.get("since")  || "-24h",
+      kind:   sp.get("kind")   || "",
+      agent:  sp.get("agent")  || "",
+      q:      sp.get("q")      || "",
+    };
+  } catch {
+    return {};
+  }
+}
+
+function _writeAuditHash(state) {
+  if (typeof location === "undefined") return;
+  const sp = new URLSearchParams();
+  if (state.since && state.since !== "-24h") sp.set("since", state.since);
+  if (state.kind)  sp.set("kind",  state.kind);
+  if (state.agent) sp.set("agent", state.agent);
+  if (state.q)     sp.set("q",     state.q);
+  const tail = sp.toString();
+  const newHash = tail ? `#audit?${tail}` : "";
+  if (location.hash !== newHash) history.replaceState(null, "", location.pathname + location.search + newHash);
+}
+
+function _auditJumpUrl(e) {
+  const kind = e.kind || "";
+  if (kind === "hitl" || kind === "inbox-pending") {
+    return `#inbox${e.target ? `?q=${encodeURIComponent(e.target)}` : ""}`;
+  }
+  if (kind === "scheduler" || kind === "system-message") {
+    return e.channel ? `#chat?channel=${encodeURIComponent(e.channel)}` : null;
+  }
+  if (kind && kind.startsWith("phase")) {
+    const parts = [];
+    if (e.project) parts.push(`project=${encodeURIComponent(e.project)}`);
+    if (e.task_id) parts.push(`task=${e.task_id}`);
+    return parts.length ? `#define?${parts.join("&")}` : null;
+  }
+  if (kind === "registry-sweep" || kind === "model-fallback") {
+    return e.agent ? `#fleet?agent=${encodeURIComponent(e.agent)}` : "#fleet";
+  }
+  return null;
+}
