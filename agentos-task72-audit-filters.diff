+def _parse_audit_window(spec: str | None) -> float | None:
+    """Parse ISO8601 or relative `-Ns/m/h/d` into epoch seconds; None if blank/invalid."""
+    if not spec:
+        return None
+    import re as _re, time as _t
+    m = _re.match(r"^-(\d+)([smhd])$", spec.strip())
+    if m:
+        n, unit = int(m.group(1)), m.group(2)
+        mult = {"s": 1, "m": 60, "h": 3600, "d": 86400}[unit]
+        return _t.time() - n * mult
+    try:
+        import datetime as _dt
+        return _dt.datetime.fromisoformat(spec).timestamp()
+    except Exception:
+        return None
+
+
+def _audit_entry_ts_epoch(entry: dict) -> float:
+    """Best-effort ISO→epoch for an audit entry's ts field. Returns 0 on failure."""
+    ts = entry.get("ts") or ""
+    if not ts:
+        return 0.0
+    try:
+        import datetime as _dt
+        return _dt.datetime.fromisoformat(ts).timestamp()
+    except Exception:
+        return 0.0
+
