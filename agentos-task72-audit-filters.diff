+@app.get("/api/audit/agents")
+async def audit_agents():
+    """Distinct agent names across the last 500 audit entries (for filter dropdowns)."""
+    entries = await audit_log(limit=500)
+    seen: set[str] = set()
+    for e in entries:
+        a = e.get("agent")
+        if a and a != "?" and isinstance(a, str):
+            seen.add(a)
+    return sorted(seen)
