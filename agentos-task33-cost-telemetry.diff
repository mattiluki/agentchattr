@@ -0,0 +1,218 @@
+#!/usr/bin/env python3
+"""Estimated per-agent cost telemetry from local CLI transcript files."""
+
+from __future__ import annotations
+
+import datetime as dt
+import json
+import logging
+import os
+import time
+from pathlib import Path
+
+log = logging.getLogger("agentos-cost")
+
+PRICES_USD_PER_MTOK = {
+    "claude-opus-4-7": {"input": 15.00, "output": 75.00},
+    "claude-sonnet-4-6": {"input": 3.00, "output": 15.00},
+    "claude-haiku-4-5": {"input": 0.80, "output": 4.00},
+    "gpt-5": {"input": 5.00, "output": 20.00},
+    "gpt-5-mini": {"input": 0.40, "output": 1.60},
+    "gemini-2.5-pro": {"input": 1.25, "output": 10.00},
+    "gemini-2.5-flash": {"input": 0.30, "output": 2.50},
+}
+
+AGENT_DEFAULT_MODELS = {
+    "claude": "claude-opus-4-7",
+    "codex": "gpt-5",
+    "gemini": "gemini-2.5-pro",
+}
+
+# kimi/qwen/kilo transcript homes are not stable in this workspace yet. Return
+# unsupported until each CLI exposes local JSONL usage telemetry.
+UNSUPPORTED_AGENTS = {"kimi", "qwen", "kilo", "minimax"}
+
+
+def _agent_roots(agent: str) -> list[Path]:
+    home = Path.home()
+    env = os.environ.get(f"{agent.upper()}_TRANSCRIPT_DIR")
+    if env:
+        return [Path(env).expanduser()]
+    if agent == "claude":
+        return [home / ".claude" / "projects"]
+    if agent == "codex":
+        return [home / ".codex" / "sessions"]
+    if agent == "gemini":
+        return [home / ".gemini" / "transcripts", home / ".gemini" / "tmp"]
+    return []
+
+
+def _recent_files(agent: str, cutoff_ts: float | None = None) -> list[Path]:
+    files = []
+    for root in _agent_roots(agent):
+        if not root.exists():
+            continue
+        for pattern in ("**/*.jsonl", "**/*.json"):
+            for path in root.glob(pattern):
+                if not path.is_file():
+                    continue
+                if cutoff_ts is not None and path.stat().st_mtime < cutoff_ts:
+                    continue
+                files.append(path)
+    files.sort(key=lambda p: p.stat().st_mtime if p.exists() else 0, reverse=True)
+    return files[:40]
+
+
+def _parse_ts(value) -> float | None:
+    if not value:
+        return None
+    if isinstance(value, (int, float)):
+        return float(value)
+    text = str(value).replace("Z", "+00:00")
+    try:
+        return dt.datetime.fromisoformat(text).timestamp()
+    except ValueError:
+        return None
+
+
+def _price(model: str, tokens_in: int, tokens_out: int) -> float:
+    rates = PRICES_USD_PER_MTOK.get(model)
+    if not rates:
+        log.warning("unknown model price: %s", model)
+        return 0.0
+    return (tokens_in / 1_000_000 * rates["input"]) + (tokens_out / 1_000_000 * rates["output"])
+
+
+def _usage_from_claude(obj: dict) -> tuple[str, int, int, float | None] | None:
+    message = obj.get("message") if isinstance(obj.get("message"), dict) else {}
+    usage = message.get("usage") if isinstance(message.get("usage"), dict) else {}
+    if not usage:
+        return None
+    model = message.get("model") or AGENT_DEFAULT_MODELS["claude"]
+    tokens_in = int(usage.get("input_tokens") or 0)
+    tokens_in += int(usage.get("cache_creation_input_tokens") or 0)
+    tokens_in += int(usage.get("cache_read_input_tokens") or 0)
+    tokens_out = int(usage.get("output_tokens") or 0)
+    return model, tokens_in, tokens_out, _parse_ts(obj.get("timestamp"))
+
+
+def _usage_from_codex(obj: dict) -> tuple[str, int, int, float | None] | None:
+    payload = obj.get("payload") if isinstance(obj.get("payload"), dict) else {}
+    if payload.get("type") != "token_count":
+        return None
+    info = payload.get("info") if isinstance(payload.get("info"), dict) else {}
+    usage = info.get("last_token_usage") if isinstance(info.get("last_token_usage"), dict) else {}
+    if not usage:
+        return None
+    model = obj.get("model") or payload.get("model") or AGENT_DEFAULT_MODELS["codex"]
+    tokens_in = int(usage.get("input_tokens") or 0)
+    tokens_out = int(usage.get("output_tokens") or 0)
+    return model, tokens_in, tokens_out, _parse_ts(obj.get("timestamp"))
+
+
+def _usage_from_gemini(obj: dict) -> tuple[str, int, int, float | None] | None:
+    usage = obj.get("usageMetadata") or obj.get("usage_metadata")
+    if not isinstance(usage, dict):
+        payload = obj.get("payload") if isinstance(obj.get("payload"), dict) else {}
+        usage = payload.get("usageMetadata") or payload.get("usage_metadata")
+    if not isinstance(usage, dict):
+        return None
+    model = obj.get("model") or usage.get("model") or AGENT_DEFAULT_MODELS["gemini"]
+    tokens_in = int(usage.get("promptTokenCount") or usage.get("prompt_token_count") or 0)
+    tokens_out = int(usage.get("candidatesTokenCount") or usage.get("candidates_token_count") or 0)
+    return model, tokens_in, tokens_out, _parse_ts(obj.get("timestamp") or obj.get("created_at"))
+
+
+def _iter_json_objects(path: Path):
+    try:
+        text = path.read_text(encoding="utf-8", errors="replace")
+    except OSError:
+        return
+    if path.suffix == ".json":
+        try:
+            obj = json.loads(text)
+        except json.JSONDecodeError:
+            return
+        if isinstance(obj, list):
+            for item in obj:
+                if isinstance(item, dict):
+                    yield item
+        elif isinstance(obj, dict):
+            yield obj
+        return
+    for line in text.splitlines():
+        if not line.strip():
+            continue
+        try:
+            obj = json.loads(line)
+        except json.JSONDecodeError:
+            continue
+        if isinstance(obj, dict):
+            yield obj
+
+
+def _empty(agent: str, window_minutes: int, unsupported: bool = False) -> dict:
+    return {
+        "agent": agent,
+        "window_minutes": window_minutes,
+        "tokens_in": 0,
+        "tokens_out": 0,
+        "model_breakdown": {},
+        "total_cost_usd": 0.0,
+        "session_cost_usd": 0.0,
+        "hourly_rate_usd": 0.0,
+        "unsupported": unsupported,
+        "has_data": False,
+    }
+
+
+def compute_agent_cost(agent_slug: str, window_minutes: int = 60) -> dict:
+    agent = agent_slug.strip().lower()
+    window_minutes = max(1, int(window_minutes or 60))
+    if agent in UNSUPPORTED_AGENTS:
+        return _empty(agent, window_minutes, unsupported=True)
+
+    parser = {
+        "claude": _usage_from_claude,
+        "codex": _usage_from_codex,
+        "gemini": _usage_from_gemini,
+    }.get(agent)
+    if not parser:
+        return _empty(agent, window_minutes, unsupported=True)
+
+    cutoff = time.time() - (window_minutes * 60)
+    files = _recent_files(agent, cutoff_ts=cutoff)
+    result = _empty(agent, window_minutes)
+    session_breakdown: dict[str, dict] = {}
+
+    for path in files:
+        for obj in _iter_json_objects(path):
+            usage = parser(obj)
+            if not usage:
+                continue
+            model, tokens_in, tokens_out, event_ts = usage
+            if tokens_in <= 0 and tokens_out <= 0:
+                continue
+
+            session_model = session_breakdown.setdefault(model, {"tokens_in": 0, "tokens_out": 0, "est_cost_usd": 0.0})
+            session_model["tokens_in"] += tokens_in
+            session_model["tokens_out"] += tokens_out
+            session_model["est_cost_usd"] += _price(model, tokens_in, tokens_out)
+
+            if event_ts is not None and event_ts < cutoff:
+                continue
+            model_row = result["model_breakdown"].setdefault(model, {"tokens_in": 0, "tokens_out": 0, "est_cost_usd": 0.0})
+            model_row["tokens_in"] += tokens_in
+            model_row["tokens_out"] += tokens_out
+            model_row["est_cost_usd"] += _price(model, tokens_in, tokens_out)
+            result["tokens_in"] += tokens_in
+            result["tokens_out"] += tokens_out
+
+    result["total_cost_usd"] = round(sum(m["est_cost_usd"] for m in result["model_breakdown"].values()), 6)
+    result["session_cost_usd"] = round(sum(m["est_cost_usd"] for m in session_breakdown.values()), 6)
+    result["hourly_rate_usd"] = round(result["total_cost_usd"] / window_minutes * 60, 6)
+    result["has_data"] = bool(result["tokens_in"] or result["tokens_out"] or result["session_cost_usd"])
+    result["files_scanned"] = len(files)
+    for row in result["model_breakdown"].values():
+        row["est_cost_usd"] = round(row["est_cost_usd"], 6)
+    return result
