+    if not seen and action in ("set", "add"):
+        output.append(f"{name}={value}")
+    ENV_PATH.parent.mkdir(parents=True, exist_ok=True)
+    ENV_PATH.write_text("\n".join(output).rstrip() + "\n", encoding="utf-8")
