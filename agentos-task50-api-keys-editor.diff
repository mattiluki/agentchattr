+    text = "---\n" + _yaml.safe_dump(fm, sort_keys=False).strip() + "\n---\n"
+    text += _json.dumps(body, indent=2, sort_keys=True) + "\n"
+    target = outgoing / _settings_env_proposal_filename(name)
+    target.write_text(text, encoding="utf-8")
+    return {
+        "id": target.stem,
