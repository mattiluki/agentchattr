+async def _fire_scheduler_nudge(op_slug: str, project: dict, op: dict, now_ts: float):
+    import datetime as _dt
+
+    channels = project.get("channels") or []
+    channel = (op.get("_frontmatter") or {}).get("channel") or (channels[0] if channels else "general")
+    fm = dict(project.get("_frontmatter") or {})
+    wf = fm.get("workflow") or {}
+    recent_raw = wf.get("recently_nudged_ids") or []
+    recent = []
+    recent_ids = set()
+    cutoff = now_ts - SCHEDULER_NUDGE_AGE_SEC
+    for item in recent_raw:
+        if isinstance(item, dict):
+            task_id = item.get("id")
+            ts = float(item.get("ts") or 0)
+        else:
+            task_id = item
+            ts = 0
+        if task_id is None or (ts and ts < cutoff):
+            continue
+        recent.append({"id": task_id, "ts": ts or now_ts})
+        recent_ids.add(task_id)
+
+    candidates = []
+    for task in sorted(project.get("tasks") or [], key=lambda t: t.get("id") or 0):
+        try:
+            task_id = task.get("id")
+            if task.get("status") == "open" and not task.get("assignee") and task_id not in recent_ids:
+                candidates.append(task)
+        except Exception:
+            continue
+
+    if not candidates:
+        log.info(f"scheduler-nudge: skipped {project['slug']!r} — no unclaimed open tasks")
+        if len(recent) != len(recent_raw):
+            wf["recently_nudged_ids"] = recent[-SCHEDULER_NUDGE_MAX_IDS:]
+            fm["workflow"] = wf
+            _write_vault_page(PROJECTS_DIR, project["slug"], fm, project.get("body") or "")
+        return False
+
+    shown = candidates[:10]
+    more = len(candidates) - len(shown)
+    lines = [f"📋 Scheduler nudge · {len(candidates)} unclaimed open tasks in `{project['slug']}`:"]
+    for task in shown:
+        title = str(task.get("title") or "(untitled)").strip()
+        notes = str(task.get("notes") or "")
+        size = ""
+        for marker in ("S", "M", "L"):
+            if f"size:{marker}" in notes or f"({marker})" in notes:
+                size = f" ({marker})"
+                break
+        lines.append(f"- #{task.get('id')} {title}{size}")
+    if more > 0:
+        lines.append(f"- +{more} more")
+
+    try:
+        await chat_send({
+            "channel": channel,
+            "sender": "scheduler",
+            "text": "\n".join(lines),
+            "no_preset": True,
+            "no_project": True,
+        })
+        stamp = _dt.datetime.fromtimestamp(now_ts).isoformat(timespec="seconds")
+        for task in candidates:
+            recent.append({"id": task.get("id"), "ts": now_ts, "at": stamp})
+        wf["recently_nudged_ids"] = recent[-SCHEDULER_NUDGE_MAX_IDS:]
+        fm["workflow"] = wf
+        _write_vault_page(PROJECTS_DIR, project["slug"], fm, project.get("body") or "")
+        log.info(f"scheduler-nudge: posted {len(candidates)} task(s) → #{channel} (project {project['slug']!r})")
+        return True
+    except Exception as e:
+        log.warning(f"scheduler-nudge: failed for {project['slug']!r}: {e}")
+        return False
+
+
