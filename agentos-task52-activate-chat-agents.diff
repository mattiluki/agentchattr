--- a/config.toml
+++ b/config.toml
@@ -32,27 +32,34 @@ label = "Gemini"
 # Override per-launch with: GEMINI_MODEL=gemini-2.5-pro
 
 [agents.kimi]
-command = "kimi"
+type = "api"
+base_url = "https://api.moonshot.cn/v1"
+model = "moonshot-v1-8k"
