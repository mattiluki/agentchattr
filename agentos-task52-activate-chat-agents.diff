+api_key_env = "MOONSHOT_API_KEY"
+temperature = 0.6
 
 [agents.qwen]
-command = "qwen"
+type = "api"
+base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
+model = "qwen-plus"
 cwd = ".."
 color = "#8b5cf6"
 label = "Qwen"
-mcp_inject = "settings_file"
-mcp_settings_path = ".qwen/settings.json"
