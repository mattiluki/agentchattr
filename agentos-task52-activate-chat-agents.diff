-inject_delay = 1.0
+api_key_env = "DASHSCOPE_API_KEY"
+temperature = 0.6
 
 [agents.kilo]
-command = "kilo"
+type = "api"
+base_url = "https://openrouter.ai/api/v1"
+model = "qwen/qwen3-coder"
 cwd = ".."
 color = "#f7f677"
 label = "Kilo"
+api_key_env = "OPENROUTER_API_KEY"
+temperature = 0.4
 
 [agents.minimax]
 type = "api"
@@ -63,6 +70,24 @@ label = "MiniMax"
 api_key_env = "MINIMAX_API_KEY"
 temperature = 1.0
 
+[agents.openrouter]
+type = "api"
+base_url = "https://openrouter.ai/api/v1"
+model = "openai/gpt-oss-120b"
+color = "#ff7a1a"
+label = "OpenRouter"
+api_key_env = "OPENROUTER_API_KEY"
+temperature = 0.7
+
+[agents.hermes]
+type = "api"
+base_url = "https://openrouter.ai/api/v1"
+model = "nousresearch/hermes-3-llama-3.1-405b"
+color = "#d946ef"
+label = "Hermes"
+api_key_env = "OPENROUTER_API_KEY"
+temperature = 0.7
+
 [routing]
 # "none" = only route on explicit @mention. "all" = route to all agents by default.
 default = "none"
