+def _normalize_agent_slug(sender: str | None) -> str:
+    slug = (sender or "").strip().lower()
+    if not slug:
+        return ""
+    base = re.sub(r"-\d+$", "", slug)
+    return base if base in _KNOWN_AGENT_SLUGS else ""
+
+
+def _parse_activity_ts(obj: dict) -> float | None:
+    raw = obj.get("timestamp") or obj.get("ts") or (obj.get("payload") or {}).get("timestamp")
+    if isinstance(raw, (int, float)):
+        return float(raw)
+    if isinstance(raw, str) and raw.strip():
+        import datetime as _dt
+        text = raw.strip().replace("Z", "+00:00")
+        try:
+            return _dt.datetime.fromisoformat(text).timestamp()
+        except Exception:
+            return None
+    return None
+
+
+def _activity_bucket(ts: float, now: float) -> int | None:
+    idx = int((now - ts) // 60)
+    return idx if 0 <= idx < 28 else None
+
+
+def _empty_activity_series() -> dict[str, list[int]]:
+    return {slug: [0] * 28 for slug, *_ in _KNOWN_AGENTS}
+
+
+def _add_activity(series: dict[str, list[int]], slug: str, ts: float | None, now: float, weight: int = 1):
+    if slug not in series or ts is None:
+        return
+    idx = _activity_bucket(ts, now)
+    if idx is not None:
+        series[slug][idx] += weight
+
+
+def _object_has_tool_activity(obj: dict) -> bool:
+    role = str(obj.get("role") or obj.get("type") or "").lower()
+    payload = obj.get("payload") if isinstance(obj.get("payload"), dict) else {}
+    message = obj.get("message") if isinstance(obj.get("message"), dict) else {}
+    keys = " ".join([role, str(payload.get("type") or ""), str(message.get("role") or "")]).lower()
+    if any(term in keys for term in ("tool", "function_call", "tool_use", "tool_result")):
+        return True
+    return any(k in obj or k in payload or k in message for k in ("tool_calls", "tool_call", "toolUse", "function_call"))
+
+
+def _collect_inspector_tool_activity(series: dict[str, list[int]], now: float):
+    import json as _json
+    for slug, root in (INSPECTOR_ROOTS.items() if "INSPECTOR_ROOTS" in globals() else []):
+        if not root.exists():
+            continue
+        patterns = ["**/chats/*.jsonl", "**/chats/*.json", "**/*.jsonl"] if slug == "gemini" else ["**/*.jsonl"]
+        files: list[Path] = []
+        for pat in patterns:
+            files.extend(root.glob(pat))
+        recent = sorted(
+            [p for p in files if p.is_file() and now - p.stat().st_mtime <= 35 * 60],
+            key=lambda p: p.stat().st_mtime,
+            reverse=True,
+        )[:8]
+        for path in recent:
+            try:
+                text = path.read_text(encoding="utf-8", errors="replace")
+            except Exception:
+                continue
+            for line in text.splitlines():
+                if not line.strip():
+                    continue
+                try:
+                    obj = _json.loads(line)
+                except Exception:
+                    continue
+                if _object_has_tool_activity(obj):
+                    _add_activity(series, slug, _parse_activity_ts(obj), now)
+
+
+def _compute_fleet_activity(force: bool = False) -> dict[str, list[int]]:
+    import json as _json
+    now = time.time()
+    if not force and now - float(_FLEET_ACTIVITY_CACHE.get("ts") or 0) < 30:
+        return _FLEET_ACTIVITY_CACHE.get("series") or _empty_activity_series()
+
+    series = _empty_activity_series()
+    log_path = AGENTCHATTR_DATA / "agentchattr_log.jsonl"
+    if log_path.exists():
+        try:
+            for line in log_path.read_text(encoding="utf-8", errors="replace").splitlines():
+                if not line.strip():
+                    continue
+                try:
+                    obj = _json.loads(line)
+                except Exception:
+                    continue
+                slug = _normalize_agent_slug(obj.get("sender"))
+                _add_activity(series, slug, _parse_activity_ts(obj), now)
+        except Exception as e:
+            log.warning(f"fleet activity chat parse failed: {e}")
+
+    try:
+        _collect_inspector_tool_activity(series, now)
+    except Exception as e:
+        log.warning(f"fleet activity tool parse failed: {e}")
+
+    _FLEET_ACTIVITY_CACHE.update({"ts": now, "series": series})
+    return series
+
+
+def _sparkline_for(slug: str) -> list[int]:
+    return list((_compute_fleet_activity().get(slug) or [0] * 28)[:28])
 
 
