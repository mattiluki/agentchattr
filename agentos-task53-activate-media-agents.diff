+#!/usr/bin/env sh
+set -eu
+cd /Users/zeroclaw/agentos
+
+load_key() {
+  key="$1"
+  eval "current=\${$key:-}"
+  if [ -z "$current" ] && command -v security >/dev/null 2>&1; then
