     return {"now": _dt.datetime.now().isoformat(timespec="seconds"), "entries": out}
 
 
+@app.get("/api/home")
+async def home_payload():
+    """One-shot Home dashboard payload composed from existing read endpoints."""
+    import json as _json
+    import time as _t
+    from pathlib import Path as _Path
+
+    project_slug = "agentos-roadmap"
+    project = _read_vault_page(PROJECTS_DIR, project_slug, PROJECT_EXTRA_FIELDS) or {}
+    wf = project.get("workflow") or {}
+    active_task_id = wf.get("active_task_id")
+    active_task = next((t for t in (project.get("tasks") or []) if t.get("id") == active_task_id), None)
+    active_phase = _phase_by_name(wf, wf.get("active_phase"))
+    events = _read_phase_events(50, project_slug)
+
+    active_focus = {
+        "project": project_slug,
+        "task_id": active_task_id,
+        "task_title": (active_task or {}).get("title"),
+        "phase": wf.get("active_phase"),
+        "phase_state": wf.get("phase_state") or "idle",
+        "agent": active_phase.get("agent") or wf.get("coordinator_agent"),
+        "last_pulse_iso": next((e.get("ts") for e in events if e.get("task_id") == active_task_id), None),
+    }
+
+    recent_commits = []
+    for ev in events:
+        for item in ev.get("commits") or []:
+            repo = item.get("repo") or ""
+            recent_commits.append({
+                "project": ev.get("project"),
+                "task_id": ev.get("task_id"),
+                "phase": ev.get("phase"),
+                "sha": item.get("sha") or item.get("commit"),
+                "repo": _Path(repo).name if repo else "",
+                "repo_path": repo,
+                "ts": ev.get("ts"),
+                "summary": ev.get("summary"),
+            })
+    recent_commits = recent_commits[:10]
+
+    try:
+        pending_hitl = sorted(await inbox(), key=lambda i: i.get("waitTime") or "")[:5]
+    except Exception:
+        pending_hitl = []
+
+    chat_recent = []
+    for channel in (project.get("channels") or ["general"])[:2]:
+        status, body = _proxy_agentchattr_get("/api/messages", {"channel": channel, "limit": 5})
+        if status != 200:
+            continue
+        try:
+            for msg in _json.loads(body):
+                text = (msg.get("text") or "").strip().replace("\n", " ")
+                ts = msg.get("time") or (
+                    _t.strftime("%Y-%m-%dT%H:%M:%S", _t.localtime(msg.get("timestamp", 0)))
+                    if msg.get("timestamp") else ""
+                )
+                chat_recent.append({
+                    "channel": channel,
+                    "sender": msg.get("sender"),
+                    "ts": ts,
+                    "preview": text[:180],
+                })
+        except Exception:
+            continue
+    chat_recent = chat_recent[-5:][::-1]
+
+    try:
+        scheduler = await scheduler_status()
+        scheduler_next = (scheduler.get("entries") or [])[:3]
+    except Exception:
+        scheduler_next = []
+
+    try:
+        fleet_rows = await fleet()
+    except Exception:
+        fleet_rows = []
+    fleet_summary = {
+        "alive": len([a for a in fleet_rows if a.get("status") == "running"]),
+        "idle": len([a for a in fleet_rows if a.get("status") == "idle"]),
+        "blocked": len([a for a in fleet_rows if a.get("status") == "error"]),
+        "agents": [{
+            "slug": a.get("name"),
+            "state": a.get("status"),
+            "color": ((a.get("_meta") or {}).get("color") or "#8a8178"),
+        } for a in fleet_rows],
+    }
+
+    return {
+        "active_focus": active_focus,
+        "recent_commits": recent_commits,
+        "pending_hitl": pending_hitl,
+        "chat_recent": chat_recent,
+        "scheduler_next": scheduler_next,
+        "fleet": fleet_summary,
+    }
+
+
 # Static file serving — mount LAST so all explicit /api/* routes register first.
 app.mount("/", StaticFiles(directory=str(UI_DIR), html=True), name="static")
 
