+def _agent_allowlist_from_config(slug: str, config: dict | None = None) -> dict:
+    config = config or _load_agent_settings_config()
+    raw = ((config.get("agents") or {}).get(slug) or {}).get("allowlist")
+    return _normalize_allowlist(slug, raw)
+
+
+@app.get("/api/agents/{slug}/allowlist")
+async def agent_allowlist_get(slug: str):
+    slug = slug.strip().lower()
+    if slug not in _KNOWN_AGENT_SLUGS:
+        return {"error": f"unknown agent slug: {slug}"}
+    allowlist = _agent_allowlist_from_config(slug)
+    return {
+        "agent": slug,
+        "allowlist": allowlist,
+        "known_tools": getattr(agent_permissions, "KNOWN_TOOLS", ["Read", "Edit", "Write", "Bash"]) if agent_permissions else ["Read", "Edit", "Write", "Bash"],
+        "translation": _translate_allowlist(slug, allowlist),
+        "requires_restart": True,
+    }
+
+
+@app.post("/api/agents/{slug}/allowlist")
+async def agent_allowlist_put(slug: str, payload: dict):
+    slug = slug.strip().lower()
+    if slug not in _KNOWN_AGENT_SLUGS:
+        return {"error": f"unknown agent slug: {slug}"}
+    allowlist = _normalize_allowlist(slug, payload.get("allowlist") or {})
+    if not allowlist.get("tools"):
+        return {"error": "allowlist must include at least one tool"}
+    if slug in ("codex", "claude") and "Read" not in allowlist.get("tools", []):
+        return {"error": "minimum allowlist must include Read"}
+    config = _load_agent_settings_config()
+    agents = config.setdefault("agents", {})
+    current = dict(agents.get(slug) or {"enabled": True, "model": _read_env_model(slug)})
+    before = current.get("allowlist")
+    current["allowlist"] = allowlist
+    agents[slug] = current
+    proposal = _write_agent_settings_proposal(config, f"Update {slug} tool permission allowlist from AgentOS")
+    _record_security_event("allowlist-changed", f"allowlist changed for @{slug}", {
+        "agent": slug,
+        "field": "allowlist",
+        "before": before,
+        "after": allowlist,
+        "changed_by": payload.get("changed_by") or "user",
+        "proposal": proposal.get("path"),
+    })
+    return {
+        "ok": True,
+        "proposal": proposal,
+        "agent": slug,
+        "allowlist": allowlist,
+        "translation": _translate_allowlist(slug, allowlist),
+        "requires_restart": True,
+    }
+
+
+@app.post("/api/permissions/check")
+async def permissions_check(payload: dict):
+    slug = (payload.get("agent") or "").strip().lower()
+    tool = (payload.get("tool") or "").strip()
+    command = (payload.get("command") or "").strip()
+    if slug not in _KNOWN_AGENT_SLUGS:
+        return {"error": f"unknown agent slug: {slug}"}
+    allowlist = _agent_allowlist_from_config(slug)
+    if tool == "Bash" and command and agent_permissions:
+        result = agent_permissions.check_bash(allowlist, command)
+    elif agent_permissions:
+        result = agent_permissions.check_tool(allowlist, tool)
+    else:
+        result = type("R", (), {"allowed": True, "reason": "permissions module unavailable", "matched": "", "kind": "allow"})()
+    if not result.allowed:
+        _record_security_event("tool-call-denied", f"denied {tool or 'tool'} for @{slug}: {result.reason}", {
+            "agent": slug,
+            "tool": tool,
+            "args_summary": command[:160],
+            "reason": result.reason,
+        })
+    return {
+        "allowed": bool(result.allowed),
+        "reason": result.reason,
+        "matched": result.matched,
+        "kind": result.kind,
+    }
+
