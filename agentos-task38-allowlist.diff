+#!/usr/bin/env python3
+"""AgentOS per-agent permission allowlist helpers.
+
+The vault schema is intentionally CLI-neutral. This module keeps the small
+translation layer that launch wrappers and serve.py can both call.
+"""
+
+from __future__ import annotations
+
+import fnmatch
+import json
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+try:
+    import yaml
+except Exception:  # pragma: no cover
+    yaml = None
+
+
+DEFAULT_ALLOWLISTS: dict[str, dict[str, Any]] = {
+    "claude": {
+        "tools": ["Read", "Edit", "Write", "Bash", "mcp__vault__*", "mcp__agentchattr__*"],
+        "paths": {
+            "read": ["/Users/zeroclaw/**"],
+            "write": ["/Users/zeroclaw/Documents/**", "/Users/zeroclaw/Documents/obsidian/LosAgentOS/**"],
+        },
+        "bash": ["git *", "ls *", "rg *", "fd *"],
+        "deny": {"bash": ["rm *", "sudo *"]},
+    },
+    "codex": {
+        "tools": ["Read", "Edit", "Write", "Bash", "mcp__vault__*", "mcp__agentchattr__*"],
+        "paths": {
+            "read": ["/Users/zeroclaw/**"],
+            "write": ["/Users/zeroclaw/Documents/**", "/Users/zeroclaw/agentos/**"],
+        },
+        "bash": ["git *", "ls *", "rg *", "sed *", "python *", ".venv/bin/python *"],
+        "deny": {"bash": ["rm *", "sudo *"]},
+    },
+    "gemini": {
+        "tools": ["Read", "Bash", "mcp__vault__*", "mcp__agentchattr__*"],
+        "paths": {
+            "read": ["/Users/zeroclaw/**"],
+            "write": ["/Users/zeroclaw/Documents/obsidian/LosAgentOS/**"],
+        },
+        "bash": ["git *", "ls *", "rg *"],
+        "deny": {"bash": ["rm *", "sudo *"]},
+    },
+}
+
+
+KNOWN_TOOLS = [
+    "Read",
+    "Edit",
+    "Write",
+    "Bash",
+    "WebFetch",
+    "WebSearch",
+    "mcp__vault__*",
+    "mcp__agentchattr__*",
+    "mcp__codex_apps__*",
+]
+
+
+@dataclass
+class PermissionCheck:
+    allowed: bool
+    reason: str
+    matched: str = ""
+    kind: str = "allow"
+
+
+def default_allowlist(agent: str) -> dict[str, Any]:
+    return normalize_allowlist(DEFAULT_ALLOWLISTS.get(agent, {
+        "tools": ["Read"],
+        "paths": {"read": ["/Users/zeroclaw/**"], "write": []},
+        "bash": [],
+        "deny": {"bash": []},
+    }))
+
+
+def normalize_allowlist(raw: dict[str, Any] | None) -> dict[str, Any]:
+    raw = raw or {}
+    paths = raw.get("paths") if isinstance(raw.get("paths"), dict) else {}
+    deny = raw.get("deny") if isinstance(raw.get("deny"), dict) else {}
+    return {
+        "tools": list(raw.get("tools") or []),
+        "paths": {
+            "read": list(paths.get("read") or []),
+            "write": list(paths.get("write") or []),
+        },
+        "bash": list(raw.get("bash") or []),
+        "deny": {"bash": list(deny.get("bash") or [])},
+    }
+
+
+def merge_with_default(agent: str, raw: dict[str, Any] | None) -> dict[str, Any]:
+    merged = default_allowlist(agent)
+    if not raw:
+        return merged
+    norm = normalize_allowlist(raw)
+    for key in ("tools", "bash"):
+        if raw.get(key) is not None:
+            merged[key] = norm[key]
+    if raw.get("paths") is not None:
+        merged["paths"] = norm["paths"]
+    if raw.get("deny") is not None:
+        merged["deny"] = norm["deny"]
+    return merged
+
+
+def check_bash(allowlist: dict[str, Any], command: str) -> PermissionCheck:
+    command = (command or "").strip()
+    deny_patterns = allowlist.get("deny", {}).get("bash") or []
+    for pattern in deny_patterns:
+        if fnmatch.fnmatch(command, pattern):
+            return PermissionCheck(False, f"bash denied by pattern {pattern!r}", pattern, "deny")
+    allow_patterns = allowlist.get("bash") or []
+    for pattern in allow_patterns:
+        if fnmatch.fnmatch(command, pattern):
+            return PermissionCheck(True, f"bash allowed by pattern {pattern!r}", pattern)
+    return PermissionCheck(False, "bash command did not match allowlist")
+
+
+def check_tool(allowlist: dict[str, Any], tool_name: str) -> PermissionCheck:
+    for pattern in allowlist.get("tools") or []:
+        if fnmatch.fnmatch(tool_name, pattern):
+            return PermissionCheck(True, f"tool allowed by pattern {pattern!r}", pattern)
+    return PermissionCheck(False, "tool did not match allowlist")
+
+
+def translate_for_cli(agent: str, allowlist: dict[str, Any]) -> dict[str, Any]:
+    allowlist = merge_with_default(agent, allowlist)
+    tools = allowlist["tools"]
+    write_paths = allowlist["paths"]["write"]
+    read_paths = allowlist["paths"]["read"]
+    bash = allowlist["bash"]
+
+    if agent == "claude":
+        allowed_tools = list(tools)
+        allowed_tools.extend(f"Bash({pattern})" for pattern in bash)
+        return {
+            "cli": "claude",
+            "flags": {
+                "allowedTools": allowed_tools,
+                "addDir": sorted(set(read_paths + write_paths)),
+            },
+        }
+    if agent == "codex":
+        return {
+            "cli": "codex",
+            "permission_file": str(Path.home() / ".codex" / "permissions" / f"{agent}.json"),
+            "config": allowlist,
+        }
+    if agent == "gemini":
+        return {
+            "cli": "gemini",
+            "trust_file": str(Path.home() / ".gemini" / "trust.json"),
+            "trusted_dirs": sorted(set(read_paths + write_paths)),
+            "tools": tools,
+        }
+    return {"cli": agent, "config": allowlist}
+
+
+def load_agent_config(path: Path) -> dict[str, Any]:
+    if not path.exists() or yaml is None:
+        return {}
+    text = path.read_text(encoding="utf-8")
+    if text.startswith("---\n"):
+        end = text.find("\n---\n", 4)
+        if end != -1:
+            text = text[end + 5:]
+    return yaml.safe_load(text) or {}
+
+
+def main() -> int:
+    import argparse
+
+    parser = argparse.ArgumentParser(description="Translate AgentOS allowlists for CLI wrappers.")
+    parser.add_argument("agent", help="agent slug, e.g. codex")
+    parser.add_argument("--config", type=Path, default=Path.home() / "Documents" / "obsidian" / "LosAgentOS" / "02-Areas" / "AI-Automation" / "AgentOS" / "runtime" / "agent-config.yaml")
+    args = parser.parse_args()
+
+    cfg = load_agent_config(args.config)
+    raw = ((cfg.get("agents") or {}).get(args.agent) or {}).get("allowlist")
+    print(json.dumps(translate_for_cli(args.agent, merge_with_default(args.agent, raw)), indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
