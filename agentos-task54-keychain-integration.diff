+#!/usr/bin/env python3
+"""macOS Keychain helpers for AgentOS API keys.
+
+Values are never logged. Callers may install an audit hook that receives
+event metadata without secret contents.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import subprocess
+from typing import Callable
+
+SERVICE_PREFIX = "agentos."
+_AUDIT_HOOK: Callable[[str, str, dict], None] | None = None
+
+
+def set_audit_hook(hook: Callable[[str, str, dict], None] | None) -> None:
+    global _AUDIT_HOOK
+    _AUDIT_HOOK = hook
+
+
+def _security_bin() -> str:
+    path = shutil.which("security") or "/usr/bin/security"
+    if not os.path.exists(path):
+        raise RuntimeError("macOS security CLI not found")
+    return path
+
+
+def _normalize_key(key_name: str) -> str:
+    key = (key_name or "").strip().upper()
+    if not re.match(r"^[A-Z_][A-Z0-9_]*$", key):
+        raise ValueError("key name must match ^[A-Z_][A-Z0-9_]*$")
+    return key
+
+
+def _service(key_name: str) -> str:
+    return SERVICE_PREFIX + _normalize_key(key_name)
+
+
+def _audit(kind: str, key_name: str, ok: bool, error: str | None = None) -> None:
+    if not _AUDIT_HOOK:
+        return
+    extra = {"agent": "user", "task_id": 54, "key": _normalize_key(key_name), "ok": ok}
+    if error:
+        extra["error"] = error[:240]
+    _AUDIT_HOOK(kind, f"{kind} {extra['key']}", extra)
+
+
+def keychain_set(key_name: str, value: str) -> dict:
+    key = _normalize_key(key_name)
+    try:
+        subprocess.run(
+            [
+                _security_bin(),
+                "add-generic-password",
+                "-a",
+                os.environ.get("USER", ""),
+                "-s",
+                _service(key),
+                "-w",
+                value,
+                "-U",
+            ],
+            check=True,
+            capture_output=True,
+            text=True,
+        )
+        _audit("keychain-set", key, True)
+        return {"ok": True, "key_name": key}
+    except Exception as exc:
+        error = str(exc)
+        _audit("keychain-set", key, False, error)
+        return {"ok": False, "key_name": key, "error": error}
+
+
+def keychain_get(key_name: str) -> str | None:
+    key = _normalize_key(key_name)
+    try:
+        result = subprocess.run(
+            [_security_bin(), "find-generic-password", "-s", _service(key), "-w"],
+            check=False,
+            capture_output=True,
+            text=True,
+        )
+        if result.returncode != 0:
+            _audit("keychain-get", key, False, "not found")
+            return None
+        _audit("keychain-get", key, True)
+        return result.stdout.rstrip("\n")
+    except Exception as exc:
+        _audit("keychain-get", key, False, str(exc))
+        return None
+
+
+def keychain_delete(key_name: str) -> dict:
+    key = _normalize_key(key_name)
+    try:
+        result = subprocess.run(
+            [_security_bin(), "delete-generic-password", "-s", _service(key)],
+            check=False,
+            capture_output=True,
+            text=True,
+        )
+        if result.returncode not in (0, 44):
+            error = (result.stderr or result.stdout or "delete failed").strip()
+            _audit("keychain-delete", key, False, error)
+            return {"ok": False, "key_name": key, "error": error}
+        _audit("keychain-delete", key, True)
+        return {"ok": True, "key_name": key}
+    except Exception as exc:
+        error = str(exc)
+        _audit("keychain-delete", key, False, error)
+        return {"ok": False, "key_name": key, "error": error}
+
+
+def keychain_list_agentos() -> list[str]:
+    try:
+        result = subprocess.run(
+            [_security_bin(), "dump-keychain"],
+            check=False,
+            capture_output=True,
+            text=True,
+            timeout=20,
+        )
+        if result.returncode != 0:
+            _audit("keychain-list", "AGENTOS", False, result.stderr.strip())
+            return []
+        keys: set[str] = set()
+        for service in re.findall(r'"svce"<blob>="([^"]+)"', result.stdout):
+            if service.startswith(SERVICE_PREFIX):
+                keys.add(service[len(SERVICE_PREFIX):])
+        _audit("keychain-list", "AGENTOS", True)
+        return sorted(keys)
+    except Exception as exc:
+        _audit("keychain-list", "AGENTOS", False, str(exc))
+        return []
