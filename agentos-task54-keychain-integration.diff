+#!/usr/bin/env python3
+"""Move secret-like ~/agentos/.env entries into macOS Keychain."""
+
+from __future__ import annotations
+
+import argparse
+import datetime as dt
+import re
+import shutil
+from pathlib import Path
+
+import keychain
+
+ENV_PATH = Path.home() / "agentos" / ".env"
+SECRET_KEY_MARKERS = ("KEY", "TOKEN", "SECRET", "PASSWORD", "PRIVATE", "CREDENTIAL", "AUTH")
+SECRET_KEY_EXACT = {
+    "OPENAI_API_KEY",
+    "ANTHROPIC_API_KEY",
+    "GEMINI_API_KEY",
+    "GOOGLE_API_KEY",
+    "GOOGLE_CLOUD_API_KEY",
+    "OPENROUTER_API_KEY",
+    "FAL_KEY",
+    "KLING_API_KEY",
+}
+
+
+def is_secret_env_key(key: str) -> bool:
+    normalized = (key or "").strip().upper()
+    return normalized in SECRET_KEY_EXACT or any(marker in normalized for marker in SECRET_KEY_MARKERS)
+
+
+def parse_env(path: Path) -> list[dict]:
+    rows = []
+    if not path.exists():
+        return rows
+    for line in path.read_text(encoding="utf-8").splitlines():
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#") or "=" not in stripped:
+            rows.append({"kind": "raw", "line": line})
+            continue
+        key, value = stripped.split("=", 1)
+        key = key.strip()
+        value = value.strip()
+        if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
+            value = value[1:-1]
+        rows.append({"kind": "env", "key": key, "value": value, "line": line})
+    return rows
+
+
+def prompt_yes_no(question: str, default_yes: bool = True) -> bool:
+    suffix = "[Y/n]" if default_yes else "[y/N]"
+    answer = input(f"{question} {suffix} ").strip().lower()
+    if not answer:
+        return default_yes
+    return answer in ("y", "yes")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="Migrate secret .env keys into macOS Keychain.")
+    parser.add_argument("--env", type=Path, default=ENV_PATH, help="Path to .env file")
+    parser.add_argument("--dry-run", action="store_true", help="Print planned changes only")
+    parser.add_argument("--yes", action="store_true", help="Migrate all detected secret keys without prompting")
+    args = parser.parse_args()
+
+    rows = parse_env(args.env)
+    candidates = [r for r in rows if r.get("kind") == "env" and is_secret_env_key(r.get("key", "")) and r.get("value")]
+    if not candidates:
+        print("No secret-like .env entries found.")
+        return 0
+
+    selected = []
+    for row in candidates:
+        key = row["key"].upper()
+        if args.yes or args.dry_run or prompt_yes_no(f"Migrate {key} to Keychain?"):
+            selected.append(row)
+
+    if not selected:
+        print("No keys selected for migration.")
+        return 0
+
+    print("Planned migrations:")
+    for row in selected:
+        print(f"  {row['key'].upper()} -> agentos.{row['key'].upper()}")
+    if args.dry_run:
+        return 0
+
+    backup = args.env.with_name(args.env.name + ".pre-keychain-migration-" + dt.datetime.now().strftime("%Y%m%d%H%M%S"))
+    shutil.copy2(args.env, backup)
+    selected_keys = {r["key"].upper() for r in selected}
+    for row in selected:
+        key = row["key"].upper()
+        result = keychain.keychain_set(key, row["value"])
+        if not result.get("ok"):
+            raise RuntimeError(f"failed to write {key} to Keychain: {result.get('error')}")
+        if keychain.keychain_get(key) != row["value"]:
+            raise RuntimeError(f"failed to verify {key} after Keychain write")
+
+    output = []
+    for row in rows:
+        if row.get("kind") == "env" and row.get("key", "").upper() in selected_keys:
+            continue
+        output.append(row.get("line", ""))
+    args.env.write_text("\n".join(output).rstrip() + "\n", encoding="utf-8")
+    print(f"Backed up .env to {backup}")
+    print(f"Migrated {len(selected)} key(s).")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
