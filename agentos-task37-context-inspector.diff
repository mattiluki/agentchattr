+# ── Per-agent context-window inspector ─────────────────────────────────────
+# Read-only transcript browser over local CLI session files. Bodies stay on
+# disk; endpoints parse and slice the source files on request.
+
+INSPECTOR_ROOTS = {
+    "claude": Path.home() / ".claude" / "projects",
+    "codex": Path.home() / ".codex" / "sessions",
+    "gemini": Path.home() / ".gemini" / "tmp",
+}
+INSPECTOR_LIMITS_FALLBACK = {
+    "claude-opus-4-7": {"context": 200000, "output": 64000},
+    "claude-sonnet-4-6": {"context": 1000000, "output": 64000},
+    "claude-haiku-4-5": {"context": 200000, "output": 64000},
+    "gpt-5.5": {"context": 258400, "output": 128000},
+    "gpt-5": {"context": 258400, "output": 128000},
+    "gpt-4o": {"context": 128000, "output": 16384},
+    "gemini-2.5-flash": {"context": 1000000, "output": 65000},
+    "gemini-2.5-pro": {"context": 2000000, "output": 65000},
+    "gemini-3-flash-preview": {"context": 1000000, "output": 65000},
+}
+_INSPECTOR_WS_CLIENTS: set = set()
+_INSPECTOR_MTIME_SNAPSHOT: dict[str, int] = {}
+
+
+def _estimate_tokens(text: str) -> int:
+    return max(1, int(len(text or "") / 4)) if text else 0
+
+
+def _content_to_text(content) -> str:
+    if content is None:
+        return ""
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        parts = []
+        for item in content:
+            if isinstance(item, str):
+                parts.append(item)
+            elif isinstance(item, dict):
+                label = item.get("type") or "content"
+                text = item.get("text") or item.get("thinking") or item.get("content")
+                if text:
+                    parts.append(f"[{label}] {text}" if label not in ("text", "content") else str(text))
+                elif item and "signature" not in item:
+                    parts.append(f"[{label}] {item}")
+            else:
+                parts.append(str(item))
+        return "\n".join(parts)
+    if isinstance(content, dict):
+        return content.get("text") or content.get("content") or str(content)
+    return str(content)
+
+
+def _extract_yaml_block(text: str) -> str:
+    if "```yaml" in text:
+        start = text.find("```yaml") + len("```yaml")
+        end = text.find("```", start)
+        return text[start:end].strip() if end != -1 else text[start:].strip()
+    if "```" in text:
+        start = text.find("```") + 3
+        end = text.find("```", start)
+        return text[start:end].strip() if end != -1 else text[start:].strip()
+    return text
+
+
+def _model_limits() -> dict:
+    limits = dict(INSPECTOR_LIMITS_FALLBACK)
+    if not MODEL_LIMITS_PATH.exists():
+        return limits
+    try:
+        import yaml as _yaml
+        raw_text = MODEL_LIMITS_PATH.read_text(encoding="utf-8")
+        raw = _yaml.safe_load(_extract_yaml_block(raw_text)) or {}
+        configured = raw.get("limits") if isinstance(raw.get("limits"), dict) else {}
+        for model, cfg in configured.items():
+            if isinstance(cfg, dict):
+                limits[str(model)] = {
+                    "context": int(cfg.get("context") or limits.get(str(model), {}).get("context") or 0),
+                    "output": int(cfg.get("output") or limits.get(str(model), {}).get("output") or 0),
+                }
+    except Exception as e:
+        log.warning(f"model limits read failed: {e}")
+    return limits
+
+
+def _context_limit_for(model: str, agent: str) -> int:
+    limits = _model_limits()
+    if model in limits:
+        return int(limits[model].get("context") or 0)
+    current = _read_env_model(agent)
+    if current in limits:
+        return int(limits[current].get("context") or 0)
+    fallback_model = (AGENT_MODELS.get(agent) or [""])[0]
+    return int(limits.get(fallback_model, {}).get("context") or 0)
+
+
+def _safe_session_id(path: Path) -> str:
+    stem = path.name[:-6] if path.name.endswith(".jsonl") else path.stem
+    return re.sub(r"[^A-Za-z0-9_.-]+", "-", stem)[:160]
+
+
+def _inspector_files(agent: str) -> list[Path]:
+    root = INSPECTOR_ROOTS.get(agent)
+    if not root or not root.exists():
+        return []
+    if agent == "gemini":
+        files = list(root.glob("**/chats/*.jsonl")) + list(root.glob("**/chats/*.json"))
+    else:
+        files = list(root.glob("**/*.jsonl"))
+    files = [p for p in files if p.is_file()]
+    files.sort(key=lambda p: p.stat().st_mtime_ns if p.exists() else 0, reverse=True)
+    return files[:40]
+
+
+def _inspector_session_record(agent: str, path: Path) -> dict:
+    stat = path.stat()
+    return {
+        "id": _safe_session_id(path),
+        "agent": agent,
+        "path": str(path),
+        "name": path.name,
+        "mtime": stat.st_mtime,
+        "updated_at": time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(stat.st_mtime)),
+        "size": stat.st_size,
+    }
+
+
+def _find_inspector_session(agent: str, session_id: str) -> Path | None:
+    for path in _inspector_files(agent):
+        if _safe_session_id(path) == session_id:
+            return path
+    return None
+
+
+def _event_from_obj(agent: str, session_id: str, obj: dict, idx: int) -> dict | None:
+    payload = obj.get("payload") if isinstance(obj.get("payload"), dict) else {}
+    message = obj.get("message") if isinstance(obj.get("message"), dict) else {}
+    role = message.get("role") or obj.get("role") or payload.get("role") or obj.get("type") or payload.get("type") or "event"
+    model = message.get("model") or obj.get("model") or payload.get("model") or ""
+    ts = obj.get("timestamp") or payload.get("timestamp") or (obj.get("$set") or {}).get("lastUpdated") or ""
+
+    body = ""
+    if message:
+        body = _content_to_text(message.get("content"))
+        if not body:
+            body = f"[{role} metadata-only event]"
+    if not body and payload:
+        body = _content_to_text(payload.get("content") or payload.get("text") or payload.get("arguments"))
+    if not body and obj.get("content") is not None:
+        body = _content_to_text(obj.get("content"))
+    if not body and obj.get("lastPrompt"):
+        body = str(obj.get("lastPrompt"))
+    if not body and obj.get("thoughts"):
+        body = _content_to_text(obj.get("thoughts"))
+    if not body:
+        body = str(obj)
+
+    # CLI telemetry often stores cumulative API usage on each event. The
+    # inspector needs per-row body pressure, so estimate from rendered body.
+    tokens = _estimate_tokens(body)
+    summary = " ".join(body.split())[:180]
+    return {
+        "id": f"{session_id}:{idx}",
+        "agent": agent,
+        "session_id": session_id,
+        "index": idx,
+        "ts": ts,
+        "role": str(role),
+        "model": str(model),
+        "tokens": tokens,
+        "summary": summary,
+        "body": body,
+    }
+
+
+def _read_context_events(agent: str, session_id: str, start: int | None = None, end: int | None = None) -> dict:
+    path = _find_inspector_session(agent, session_id)
+    if not path:
+        return {"error": "session not found", "events": []}
+    import json as _json
+    text = path.read_text(encoding="utf-8", errors="replace")
+    if text and not text.endswith("\n"):
+        text = text.rsplit("\n", 1)[0]
+    events = []
+    for idx, line in enumerate(text.splitlines()):
+        if not line.strip():
+            continue
+        try:
+            obj = _json.loads(line)
+        except Exception:
+            continue
+        ev = _event_from_obj(agent, session_id, obj, idx)
+        if ev:
+            events.append(ev)
+    total_events = len(events)
+    running = 0
+    model = ""
+    for ev in events:
+        running += ev.get("tokens") or 0
+        ev["running_tokens"] = running
+        if ev.get("model"):
+            model = ev["model"]
+    total_tokens = running
+    if start is None and end is None:
+        events = events[-500:]
+    else:
+        events = events[max(0, start or 0): end if end is not None else None]
+    context_limit = _context_limit_for(model, agent)
+    pct = (total_tokens / context_limit * 100) if context_limit else 0
+    return {
+        "agent": agent,
+        "session": _inspector_session_record(agent, path),
+        "events": events,
+        "total_events": total_events,
+        "total_tokens": total_tokens,
+        "model": model or _read_env_model(agent),
+        "context_limit": context_limit,
+        "context_pct": pct,
+    }
+
+
+@app.get("/api/inspector/{agent}/sessions")
+async def inspector_sessions(agent: str):
+    agent = agent.strip().lower()
+    if agent not in INSPECTOR_ROOTS:
+        return {"error": f"unknown agent: {agent}", "sessions": []}
+    return {"agent": agent, "sessions": [_inspector_session_record(agent, p) for p in _inspector_files(agent)]}
+
+
+@app.get("/api/inspector/{agent}/sessions/{session_id}/events")
+async def inspector_session_events(
+    agent: str,
+    session_id: str,
+    from_: int | None = Query(default=None, alias="from"),
+    to: int | None = None,
+):
+    return _read_context_events(agent.strip().lower(), session_id, from_, to)
+
+
+@app.websocket("/ws/inspector")
+async def ws_inspector(client_ws: WebSocket):
+    await client_ws.accept()
+    _INSPECTOR_WS_CLIENTS.add(client_ws)
+    try:
+        while True:
+            await client_ws.receive_text()
+    except WebSocketDisconnect:
+        pass
+    except Exception:
+        pass
+    finally:
+        _INSPECTOR_WS_CLIENTS.discard(client_ws)
+
+
+async def _broadcast_inspector_update(agent: str, session_id: str):
+    import json as _json
+    payload = _json.dumps({"type": "inspector.update", "agent": agent, "session_id": session_id})
+    dead = []
+    for ws in list(_INSPECTOR_WS_CLIENTS):
+        try:
+            await ws.send_text(payload)
+        except Exception:
+            dead.append(ws)
+    for ws in dead:
+        _INSPECTOR_WS_CLIENTS.discard(ws)
+
+
+async def _inspector_tail_loop():
+    await asyncio.sleep(5)
+    while True:
+        try:
+            for agent in INSPECTOR_ROOTS:
+                for path in _inspector_files(agent)[:8]:
+                    key = f"{agent}:{path}"
+                    mtime = path.stat().st_mtime_ns
+                    if key not in _INSPECTOR_MTIME_SNAPSHOT:
+                        _INSPECTOR_MTIME_SNAPSHOT[key] = mtime
+                    elif _INSPECTOR_MTIME_SNAPSHOT[key] != mtime:
+                        _INSPECTOR_MTIME_SNAPSHOT[key] = mtime
+                        await _broadcast_inspector_update(agent, _safe_session_id(path))
+        except Exception as e:
+            log.warning(f"inspector tail tick failed: {e}")
+        await asyncio.sleep(5)
+
+
+@app.on_event("startup")
+async def _start_inspector_tail_loop():
+    asyncio.create_task(_inspector_tail_loop())
+
+
