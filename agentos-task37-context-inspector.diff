+SECRET_KEY_MARKERS = ("KEY", "TOKEN", "SECRET", "PASSWORD", "PRIVATE", "CREDENTIAL", "AUTH")
+SECRET_KEY_EXACT = {
+    "OPENAI_API_KEY",
+    "ANTHROPIC_API_KEY",
+    "GEMINI_API_KEY",
+    "GOOGLE_API_KEY",
+    "OPENROUTER_API_KEY",
+}
+
+
+def _is_secret_env_key(key: str) -> bool:
+    normalized = (key or "").strip().upper()
+    return normalized in SECRET_KEY_EXACT or any(marker in normalized for marker in SECRET_KEY_MARKERS)
+
+
+def _agent_settings_defaults() -> dict:
+    agents = {}
+    for slug, options in AGENT_MODELS.items():
+        agents[slug] = {
+            "enabled": True,
+            "model": _read_env_model(slug) or (options[0] if options else ""),
+        }
+    for slug, _color, model_hint, _cmd, _vault_ok in _KNOWN_AGENTS:
+        agents.setdefault(slug, {"enabled": True, "model": model_hint})
+    return {"env": {}, "agents": agents}
+
+
+def _load_agent_settings_config() -> dict:
+    defaults = _agent_settings_defaults()
+    if not AGENT_CONFIG_PATH.exists():
+        return defaults
+    try:
+        import yaml as _yaml
+        text = AGENT_CONFIG_PATH.read_text(encoding="utf-8")
+        if text.startswith("---\n"):
+            end = text.find("\n---\n", 4)
+            if end != -1:
+                text = text[end + 5:]
+        raw = _yaml.safe_load(text) or {}
+    except Exception as e:
+        log.warning(f"settings config read failed: {e}")
+        raw = {}
+    env = raw.get("env") if isinstance(raw.get("env"), dict) else {}
+    agents_raw = raw.get("agents") if isinstance(raw.get("agents"), dict) else {}
+    agents = defaults["agents"]
+    for slug, cfg in agents_raw.items():
+        if not isinstance(cfg, dict):
+            continue
+        current = agents.setdefault(slug, {"enabled": True, "model": ""})
+        if "enabled" in cfg:
+            current["enabled"] = bool(cfg.get("enabled"))
+        if cfg.get("model") is not None:
+            current["model"] = str(cfg.get("model") or "")
+    return {"env": {str(k): str(v) for k, v in env.items()}, "agents": agents}
+
+
+def _agent_enabled(slug: str) -> bool:
+    return bool((_load_agent_settings_config().get("agents") or {}).get(slug, {}).get("enabled", True))
+
+
+def _disabled_agents_in_text(text: str) -> list[str]:
+    mentions = {m.group(1).lower() for m in re.finditer(r"@([A-Za-z][A-Za-z0-9_-]*)", text or "")}
+    return sorted(slug for slug in mentions if slug in _KNOWN_AGENT_SLUGS and not _agent_enabled(slug))
+
+
+def _settings_system_env() -> list[dict]:
+    import os as _os
+    keys = {
+        "AGENTOS_PORT",
+        "AGENTOS_HOST",
+        "AGENTCHATTR_PORT",
+        "OPENAI_API_KEY",
+        "ANTHROPIC_API_KEY",
+        "GEMINI_API_KEY",
+        "GOOGLE_API_KEY",
+        "OPENROUTER_API_KEY",
+    }
+    keys.update(k for k in _os.environ if k.startswith("AGENTOS_"))
+    rows = []
+    for key in sorted(keys):
+        value = _os.environ.get(key, "")
+        secret = _is_secret_env_key(key)
+        rows.append({
+            "key": key,
+            "value": "••••••••" if secret and value else value,
+            "set": bool(value),
+            "secret": secret,
+            "source": "process",
+            "read_only": True,
+        })
+    return rows
+
+
+def _settings_proposal_filename() -> str:
+    import datetime as _dt
+    stamp = _dt.datetime.now().strftime("%Y%m%dT%H%M%S%f")
+    target_slug = AGENT_CONFIG_REL.replace("/", "__")
+    return f"{stamp}_{target_slug}.md"
+
+
+def _write_agent_settings_proposal(config: dict, rationale: str) -> dict:
+    import datetime as _dt
+    import yaml as _yaml
+    outgoing = VAULT / "00-Inbox" / "Outgoing"
+    outgoing.mkdir(parents=True, exist_ok=True)
+    proposed_at = _dt.datetime.now().isoformat(timespec="seconds")
+    fm = {
+        "type": "proposal",
+        "target_path": AGENT_CONFIG_REL,
+        "operation": "replace",
+        "agent_id": "codex",
+        "rationale": rationale,
+        "proposed_at": proposed_at,
+        "task_id": 36,
+    }
+    body = _yaml.safe_dump(config, sort_keys=False, allow_unicode=True).strip() + "\n"
+    text = "---\n" + _yaml.safe_dump(fm, sort_keys=False, allow_unicode=True).strip() + "\n---\n" + body
+    target = outgoing / _settings_proposal_filename()
+    target.write_text(text, encoding="utf-8")
+    return {
+        "id": target.stem,
+        "path": str(target.relative_to(VAULT)),
+        "target_path": AGENT_CONFIG_REL,
+        "proposed_at": proposed_at,
+    }
+
+
+def _settings_payload(config: dict | None = None) -> dict:
+    config = config or _load_agent_settings_config()
+    agent_rows = []
+    for slug, cfg in sorted((config.get("agents") or {}).items()):
+        agent_rows.append({
+            "slug": slug,
+            "enabled": bool(cfg.get("enabled", True)),
+            "model": cfg.get("model") or "",
+            "options": AGENT_MODELS.get(slug, []),
+            "known": slug in _KNOWN_AGENT_SLUGS,
+        })
+    env_rows = []
+    for key, value in sorted((config.get("env") or {}).items()):
+        secret = _is_secret_env_key(key)
+        env_rows.append({
+            "key": key,
+            "value": "••••••••" if secret and value else value,
+            "set": bool(value),
+            "secret": secret,
+            "source": "config",
+            "read_only": False,
+        })
+    return {
+        "env": env_rows,
+        "agents": agent_rows,
+        "system_env": _settings_system_env(),
+        "models": AGENT_MODELS,
+        "meta": {
+            "config_path": AGENT_CONFIG_REL,
+            "exists": AGENT_CONFIG_PATH.exists(),
+            "secret_markers": list(SECRET_KEY_MARKERS),
+        },
+    }
+
+
+@app.get("/api/settings")
+async def settings_get():
+    return _settings_payload()
+
+
+@app.post("/api/settings/env")
+async def settings_env_put(payload: dict):
+    key = (payload.get("key") or "").strip().upper()
+    value = str(payload.get("value") or "")
+    if not re.match(r"^[A-Z_][A-Z0-9_]*$", key):
+        return {"error": "env key must match ^[A-Z_][A-Z0-9_]*$"}
+    if _is_secret_env_key(key):
+        return {"error": f"{key} looks like a secret; store it in the process environment, not agent-config.yaml"}
+    config = _load_agent_settings_config()
+    config.setdefault("env", {})[key] = value
+    proposal = _write_agent_settings_proposal(config, f"Update runtime env setting {key} from Settings UI")
+    return {"ok": True, "proposal": proposal, "settings": _settings_payload(config)}
+
+
+@app.post("/api/settings/agent")
+async def settings_agent_put(payload: dict):
+    slug = (payload.get("slug") or "").strip().lower()
+    if slug not in _KNOWN_AGENT_SLUGS:
+        return {"error": f"unknown agent slug: {slug}"}
+    config = _load_agent_settings_config()
+    agents = config.setdefault("agents", {})
+    current = dict(agents.get(slug) or {"enabled": True, "model": _read_env_model(slug)})
+    if "enabled" in payload:
+        current["enabled"] = bool(payload.get("enabled"))
+    if "model" in payload:
+        model = str(payload.get("model") or "").strip()
+        if not model:
+            return {"error": "model required"}
+        current["model"] = model
+    agents[slug] = current
+    proposal = _write_agent_settings_proposal(config, f"Update {slug} agent settings from Settings UI")
+    return {"ok": True, "proposal": proposal, "settings": _settings_payload(config)}
+
