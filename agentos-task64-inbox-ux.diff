+                "task_id": ev.get("task_id"),
+                "phase": ev.get("phase"),
+                "sha": item.get("sha") or item.get("commit"),
+                "repo": _Path(repo).name if repo else "",
+                "repo_path": repo,
+                "ts": ev.get("ts"),
+                "summary": ev.get("summary"),
+            })
+    recent_commits = recent_commits[:10]
+
+    try:
+        pending_hitl = sorted(await inbox(), key=lambda i: i.get("waitTime") or "")[:5]
+    except Exception:
+        pending_hitl = []
+
+    chat_recent = []
+    for channel in (project.get("channels") or ["general"])[:2]:
+        status, body = _proxy_agentchattr_get("/api/messages", {"channel": channel, "limit": 5})
+        if status != 200:
+            continue
+        try:
+            for msg in _json.loads(body):
+                text = (msg.get("text") or "").strip().replace("\n", " ")
+                ts = msg.get("time") or (
+                    _t.strftime("%Y-%m-%dT%H:%M:%S", _t.localtime(msg.get("timestamp", 0)))
+                    if msg.get("timestamp") else ""
+                )
+                chat_recent.append({
+                    "channel": channel,
+                    "sender": msg.get("sender"),
+                    "ts": ts,
+                    "preview": text[:180],
+                })
+        except Exception:
+            continue
+    chat_recent = chat_recent[-5:][::-1]
+
+    try:
