+    except Exception:
+        scheduler_next = []
+
+    try:
+        fleet_rows = await fleet()
+    except Exception:
+        fleet_rows = []
+    fleet_summary = {
+        "alive": len([a for a in fleet_rows if a.get("status") == "running"]),
+        "idle": len([a for a in fleet_rows if a.get("status") == "idle"]),
+        "blocked": len([a for a in fleet_rows if a.get("status") == "error"]),
+        "agents": [{
+            "slug": a.get("name"),
+            "state": a.get("status"),
+            "color": ((a.get("_meta") or {}).get("color") or "#8a8178"),
+        } for a in fleet_rows],
+    }
+
+    return {
+        "active_focus": active_focus,
+        "recent_commits": recent_commits,
+        "pending_hitl": pending_hitl,
+        "chat_recent": chat_recent,
