diff --git a/ui-static/screens/home.jsx b/ui-static/screens/home.jsx
new file mode 100644
index 0000000..66d693c
--- /dev/null
+++ b/ui-static/screens/home.jsx
@@ -0,0 +1,171 @@
+// home.jsx — unified activity dashboard
+
+function HomeScreen({ onNavigate }) {
+  const [data, setData] = React.useState(null);
+  const [loading, setLoading] = React.useState(true);
+  const [error, setError] = React.useState("");
+  const vp = useViewport();
+
+  const load = React.useCallback(() => {
+    setLoading(true);
+    fetch("/api/home")
+      .then((r) => r.json())
+      .then((d) => {
+        setData(d || {});
+        setError("");
+        setLoading(false);
+      })
+      .catch((e) => {
+        setError(String(e).slice(0, 160));
+        setLoading(false);
+      });
+  }, []);
+
+  React.useEffect(() => {
+    load();
+    const t = setInterval(load, 15000);
+    return () => clearInterval(t);
+  }, [load]);
+
+  const focus = data?.active_focus || {};
+  const fleet = data?.fleet || {};
+  const pending = data?.pending_hitl || [];
+  const commits = data?.recent_commits || [];
+  const chat = data?.chat_recent || [];
+  const scheduler = data?.scheduler_next || [];
+
+  return (
+    <div className="screen" style={{padding: 18}}>
+      <div style={{display: "flex", alignItems: "center", gap: 12, marginBottom: 14}}>
+        <div>
+          <div className="screen-eyebrow mono">home</div>
+          <div className="screen-title">Activity dashboard</div>
+          <div className="screen-sub">Current workflow, approvals, commits, chat, scheduler, and fleet state.</div>
+        </div>
+        <div style={{flex: 1}} />
+        <button className="btn btn-ghost mono" onClick={load}>{loading ? "loading..." : "refresh"}</button>
+      </div>
+
+      {error && <div className="define-msg mono" style={{marginBottom: 12}}>error: {error}</div>}
+
+      <div style={{
+        display: "grid",
+        gridTemplateColumns: vp.isMobile ? "1fr" : "minmax(0, 1.2fr) minmax(300px, 0.8fr)",
+        gap: 14,
+      }}>
+        <HomeCard title="Active focus" action="workflows" onNavigate={onNavigate}>
+          <div style={{display: "flex", alignItems: "center", gap: 10}}>
+            <span className="mono" style={{
+              padding: "3px 8px", borderRadius: 999, border: "1px solid var(--line)",
+              background: "var(--accent-soft)", color: "var(--accent-ink)", fontSize: 11,
+            }}>{focus.phase_state || "idle"}</span>
+            <span className="mono muted">{focus.project || "agentos-roadmap"}</span>
+          </div>
+          <div style={{fontSize: 18, fontWeight: 650, marginTop: 10, lineHeight: 1.25}}>
+            {focus.task_title || "No active task"}
+          </div>
+          <div className="mono muted" style={{marginTop: 8}}>
+            task {focus.task_id ? `#${focus.task_id}` : "none"} · phase {focus.phase || "none"} · @{focus.agent || "?"}
+          </div>
+          <div className="mono muted" style={{marginTop: 6, fontSize: 11}}>
+            last event {focus.last_pulse_iso || "not recorded"}
+          </div>
+        </HomeCard>
+
+        <HomeCard title="Fleet snapshot" action="fleet" onNavigate={onNavigate}>
+          <div style={{display: "flex", gap: 14, marginBottom: 12}}>
+            <HomeMetric label="running" value={fleet.alive || 0} color="var(--ok)" />
+            <HomeMetric label="idle" value={fleet.idle || 0} color="var(--warn)" />
+            <HomeMetric label="blocked" value={fleet.blocked || 0} color="var(--err)" />
+          </div>
+          <div style={{display: "flex", gap: 6, overflowX: "auto", paddingBottom: 2}}>
+            {(fleet.agents || []).slice(0, 16).map((a) => (
+              <span key={a.slug} className="mono" title={`${a.slug}: ${a.state}`} style={{
+                display: "inline-flex", alignItems: "center", gap: 5, padding: "4px 7px",
+                border: "1px solid var(--line)", borderRadius: 999, whiteSpace: "nowrap", fontSize: 11,
+              }}>
+                <span style={{width: 7, height: 7, borderRadius: "50%", background: a.color || "var(--muted)"}} />
+                {a.slug}
+              </span>
+            ))}
+          </div>
+        </HomeCard>
+
+        <HomeCard title="Pending HITL" action="inbox" onNavigate={onNavigate}>
+          {pending.length === 0 ? (
+            <HomeEmpty>All approvals up to date.</HomeEmpty>
+          ) : pending.map((item) => (
+            <HomeRow key={item.id} left={item.title || item.id} right={item.waitTime || ""} sub={item.summary || item.target || ""} />
+          ))}
+        </HomeCard>
+
+        <HomeCard title="Recent phase commits" action="workflows" onNavigate={onNavigate}>
+          {commits.length === 0 ? (
+            <HomeEmpty>No phase commits recorded.</HomeEmpty>
+          ) : commits.map((c, i) => (
+            <HomeRow key={`${c.ts}-${c.sha}-${i}`} left={`#${c.task_id || "?"} ${c.phase || "phase"}`} right={c.sha || ""} sub={`${c.repo || "repo"} · ${c.ts || ""}`} mono />
+          ))}
+        </HomeCard>
+
+        <HomeCard title="Project chat" action="chat" onNavigate={onNavigate}>
+          {chat.length === 0 ? (
+            <HomeEmpty>No recent chat messages.</HomeEmpty>
+          ) : chat.map((m, i) => (
+            <HomeRow key={`${m.channel}-${m.ts}-${i}`} left={`#${m.channel} · ${m.sender || "?"}`} right={m.ts || ""} sub={m.preview || ""} />
+          ))}
+        </HomeCard>
+
+        <HomeCard title="Scheduler next fires" action="audit" onNavigate={onNavigate}>
+          {scheduler.length === 0 ? (
+            <HomeEmpty>No scheduled operations due.</HomeEmpty>
+          ) : scheduler.map((s) => (
+            <HomeRow key={`${s.project}-${s.operation}`} left={s.operation} right={s.next_due || ""} sub={`${s.project} · ${s.trigger}`} mono />
+          ))}
+        </HomeCard>
+      </div>
+    </div>
+  );
+}
+
+function HomeCard({ title, action, onNavigate, children }) {
+  return (
+    <section style={{
+      border: "1px solid var(--line)", borderRadius: 8, background: "var(--bg-elev)",
+      padding: 14, minHeight: 154,
+    }}>
+      <div style={{display: "flex", alignItems: "center", gap: 10, marginBottom: 10}}>
+        <div style={{fontWeight: 700, fontSize: 14}}>{title}</div>
+        <div style={{flex: 1}} />
+        {action && <button className="btn btn-ghost mono" style={{fontSize: 11}} onClick={() => onNavigate(action)}>see all</button>}
+      </div>
+      {children}
+    </section>
+  );
+}
+
+function HomeMetric({ label, value, color }) {
+  return (
+    <div>
+      <div style={{fontSize: 24, fontWeight: 700, color}}>{value}</div>
+      <div className="mono muted" style={{fontSize: 11}}>{label}</div>
+    </div>
+  );
+}
+
+function HomeRow({ left, right, sub, mono }) {
+  return (
+    <div style={{padding: "8px 0", borderTop: "1px solid var(--line)"}}>
+      <div style={{display: "flex", gap: 10, alignItems: "baseline"}}>
+        <div className={mono ? "mono" : ""} style={{fontWeight: 600, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap"}}>{left}</div>
+        <div className="mono muted" style={{marginLeft: "auto", fontSize: 10.5, whiteSpace: "nowrap"}}>{right}</div>
+      </div>
+      {sub && <div className="muted" style={{fontSize: 12, marginTop: 2, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap"}}>{sub}</div>}
+    </div>
+  );
+}
+
+function HomeEmpty({ children }) {
+  return <div className="muted" style={{padding: "18px 0", fontSize: 13}}>{children}</div>;
+}
+
+window.HomeScreen = HomeScreen;
